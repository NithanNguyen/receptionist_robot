        <mxCell id="7JBYn4sk39azXEOEYMLu-75" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.529;entryY=0;entryDx=0;entryDy=0;strokeColor=#2F5496;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=9;labelBackgroundColor=#FFFFFF;" target="7JBYn4sk39azXEOEYMLu-56" value="&lt;span style=&#39;font-size:9px&#39;&gt;goal pose&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
