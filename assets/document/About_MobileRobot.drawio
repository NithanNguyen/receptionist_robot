        <mxCell id="7JBYn4sk39azXEOEYMLu-42" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#0E2841;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="DWB Local Planner — Mô hình điều khiển / quỹ đạo cục bộ  ·  nav2_params_test.yaml  ·  ROS 2 Foxy" vertex="1">
          <mxGeometry height="50" width="1614" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-43" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F5496;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" value="INPUTS" vertex="1">
          <mxGeometry height="30" width="260" x="40" y="420" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-44" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F5496;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" value="SENSOR DATA" vertex="1">
          <mxGeometry height="30" width="260" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-45" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F5496;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" value="OUTPUTS" vertex="1">
          <mxGeometry height="30" width="260" x="1280" y="120" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;/plan&lt;/b&gt;  (nav_msgs/Path)&lt;br&gt;&lt;i&gt;Nguồn: planner_server (NavFn / A*)&lt;/i&gt;&lt;br&gt;Chuỗi pose tạo thành đường dẫn toàn cục;&lt;br&gt;dùng bởi PathAlign, PathDist, GoalAlign, GoalDist." vertex="1">
          <mxGeometry height="90" width="260" x="40" y="570" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;TF: map → odom → base_footprint&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nguồn: AMCL + EKF (robot_localization)&lt;/i&gt;&lt;br&gt;Pose tức thời trong frame odom;&lt;br&gt;điểm xuất phát rollout tích phân Stage ②." vertex="1">
          <mxGeometry height="90" width="260" x="40" y="885" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;/odometry/filtered&lt;/b&gt;  (nav_msgs/Odometry)&lt;br&gt;&lt;i&gt;Nguồn: EKF — IMU ⊕ wheel_odom&lt;/i&gt;&lt;br&gt;Vận tốc hiện tại (vx_cur, ω_cur) — làm seed&lt;br&gt;trung tâm cửa sổ động Stage ①." vertex="1">
          <mxGeometry height="90" width="260" x="40" y="720" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;Goal Pose&lt;/b&gt;  (geometry_msgs/PoseStamped)&lt;br&gt;&lt;i&gt;Nguồn: bt_navigator (FollowPath action)&lt;/i&gt;&lt;br&gt;Mục tiêu cuối cùng; phán định bởi Goal Checker;&lt;br&gt;GoalAlign / GoalDist dùng để chấm điểm." vertex="1">
          <mxGeometry height="90" width="260" x="40" y="460" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;/scan_filtered&lt;/b&gt;  (sensor_msgs/LaserScan)&lt;br&gt;&lt;i&gt;Nguồn: scan_to_scan_filter_chain (RPLIDAR S2E)&lt;/i&gt;&lt;br&gt;Quét LiDAR đã lọc nhiễu thân robot;&lt;br&gt;marking/clearing obstacle_layer (max 7.0 m)." vertex="1">
          <mxGeometry height="90" width="260" x="40" y="185" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;/ultrasonic_scan&lt;/b&gt;  (sensor_msgs/LaserScan)&lt;br&gt;&lt;i&gt;Nguồn: ultrasonic_fusion_node&lt;/i&gt;&lt;br&gt;Quét siêu âm 0.02–2.0 m; bổ sung góc mù&lt;br&gt;LiDAR vào obstacle_layer." vertex="1">
          <mxGeometry height="90" width="260" x="40" y="285" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="1395" width="720" x="440" y="120" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#0E2841;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="&lt;b&gt;controller_server  ·  controller_frequency = 20 Hz  ·  plugin = dwb_core::DWBLocalPlanner&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;font-weight:normal&#39;&gt;controller_plugins = [FollowPath]  ·  short_circuit_trajectory_evaluation = True  ·  stateful = True  ·  debug_trajectory_details = False&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="720" x="440" y="120" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;Pre-processing: Local Costmap&lt;/b&gt;  &lt;span style=&#39;font-size:10px;font-weight:normal&#39;&gt;(nav2_costmap_2d — rolling_window = true, frame = odom)&lt;/span&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Biến đổi dữ liệu cảm biến thô → lưới chi phí 2-D cục bộ; cung cấp thông tin va chạm cho Stage ② và điểm phạt BaseObstacle trong Stage ③.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Liên tục @ 20 Hz (update_frequency = 20.0); cửa sổ 5 × 5 m cuộn theo robot.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) &lt;b&gt;obstacle_layer:&lt;/b&gt; ray-trace /scan_filtered (obstacle_max = 7.0 m) và /ultrasonic_scan (obstacle_max = 2.0 m)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ marking ô bị chiếm; clearing ô tự do theo tia chùm&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) &lt;b&gt;inflation_layer:&lt;/b&gt; phồng quanh vật cản bán kính 0.37 m&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cost(d) = 253 · exp( −1.5 · (d − inscribed_r) )&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; 5 × 5 m @ &lt;b&gt;0.05&lt;/b&gt; m/ô  ·  footprint [[0.35, ±0.32], [−0.14, ±0.32]]  ·  footprint_padding = &lt;b&gt;0.01&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cost_scaling_factor = &lt;b&gt;1.5&lt;/b&gt;  ·  inflation_radius = &lt;b&gt;0.37&lt;/b&gt; m" vertex="1">
          <mxGeometry height="220" width="660" x="470" y="185" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;Progress Checker&lt;/b&gt;  &lt;span style=&#39;font-size:10px;font-weight:normal&#39;&gt;(SimpleProgressChecker)&lt;/span&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Phát hiện robot bị kẹt (không đủ tiến triển) → kích hoạt recoveries_server.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Mỗi tick @ 20 Hz; so sánh pose hiện tại với pose tham chiếu.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Δpos = dist(current_pose, last_pose_ref)&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Δpos &amp;lt; 0.1 m trong 15 s → FAILURE → Recovery&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; radius = &lt;b&gt;0.1&lt;/b&gt; m  ·  time_allowance = &lt;b&gt;15.0&lt;/b&gt; s" vertex="1">
          <mxGeometry height="140" width="310" x="470" y="425" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;Goal Checker&lt;/b&gt;  &lt;span style=&#39;font-size:10px;font-weight:normal&#39;&gt;(SimpleGoalChecker)&lt;/span&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Xác định robot đạt đích → kết thúc FollowPath action thành công.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Mỗi tick @ 20 Hz, sau khi Stage ④ xuất cmd_vel.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Δxy = dist(robot, goal)  ;  Δyaw = |θ_r − θ_g|&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Δxy &amp;lt; 0.25 m  AND  Δyaw &amp;lt; 0.2 rad → SUCCESS&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) stateful = True: giữ trạng thái &#39;đạt&#39; qua tick dao động nhỏ&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; xy_tol = &lt;b&gt;0.25&lt;/b&gt; m  ·  yaw_tol = &lt;b&gt;0.2&lt;/b&gt; rad (~11.5°)  ·  stateful = True" vertex="1">
          <mxGeometry height="140" width="340" x="790" y="425" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;① Dynamic Window — Sinh không gian vận tốc khả thi&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Rời rạc hoá tập lệnh (v, ω) đạt được trong 1 tick, giới hạn đồng thời bởi gia tốc và vận tốc tối đa phần cứng.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Mỗi tick @ 20 Hz; đọc (vx_cur, ω_cur) từ /odometry/filtered; dt = 1/20 s = 0.05 s.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) DW_v  =  [ max(0.0, vx_cur − |decel_x|·dt) ,  min(0.4, vx_cur + acc_x·dt) ]&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) DW_ω  =  [ max(−1.5, ω_cur − |decel_θ|·dt) ,  min(1.5, ω_cur + acc_θ·dt) ]&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Rời rạc: vx_samples = 12  ×  vθ_samples = 15  =  &lt;b&gt;180 ứng viên (vᵢ, ωⱼ)&lt;/b&gt; mỗi chu kỳ&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) Lọc ngưỡng dừng: loại nếu |v| &amp;lt; 0.02 m/s  AND  |ω| &amp;lt; 0.1 rad/s  (robot đứng yên)&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; max_vel_x = &lt;b&gt;0.4&lt;/b&gt;  ·  max_vel_theta = &lt;b&gt;±1.5&lt;/b&gt;  ·  min_speed_theta = &lt;b&gt;0.4&lt;/b&gt;  ·  max_speed_xy = &lt;b&gt;0.4&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;acc_lim_x = &lt;b&gt;0.1&lt;/b&gt;  ·  acc_lim_theta = &lt;b&gt;1.0&lt;/b&gt;  ·  decel_lim_x = &lt;b&gt;−0.35&lt;/b&gt;  ·  decel_lim_theta = &lt;b&gt;−1.0&lt;/b&gt; [m/s², rad/s²]" vertex="1">
          <mxGeometry height="220" width="660" x="470" y="585" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;② Forward Simulation — Mô phỏng tiến từng ứng viên (vᵢ, ωⱼ)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Dự báo quỹ đạo 1.5 s cho từng ứng viên; loại ứng viên gây va chạm với local_costmap.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Mỗi ứng viên từ Stage ①; pose từ TF; costmap từ local_costmap (update 20 Hz).&lt;br&gt;&lt;b&gt;Quy trình&lt;/b&gt; (tích phân Euler, Δt = linear_granularity / v):&lt;br&gt;&amp;nbsp;&amp;nbsp;x(t+Δt)  =  x(t) + v · cos(θ(t)) · Δt&lt;br&gt;&amp;nbsp;&amp;nbsp;y(t+Δt)  =  y(t) + v · sin(θ(t)) · Δt&lt;br&gt;&amp;nbsp;&amp;nbsp;θ(t+Δt)  =  θ(t) + ω · Δt&lt;br&gt;&amp;nbsp;&amp;nbsp;→ Sau mỗi bước cung (linear_granularity = 0.05 m): tra costmap → ô lethal (cost ≥ 253) → loại&lt;br&gt;&amp;nbsp;&amp;nbsp;→ Quỹ đạo sống sót → chuyển sang Stage ③&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; sim_time = &lt;b&gt;1.5&lt;/b&gt; s  ·  linear_granularity = &lt;b&gt;0.05&lt;/b&gt; m  ·  angular_granularity = &lt;b&gt;0.025&lt;/b&gt; rad&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;transform_tolerance = &lt;b&gt;0.5&lt;/b&gt; s  ·  trans_stopped_velocity = &lt;b&gt;0.02&lt;/b&gt; m/s  ·  theta_stopped = &lt;b&gt;0.1&lt;/b&gt; rad/s" vertex="1">
          <mxGeometry height="210" width="660" x="470" y="825" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-59" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#A97D00;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" value="&lt;b&gt;③ Trajectory Scoring — Chấm điểm tổng hợp qua 7 critic&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;score(traj) = Σᵢ  scaleᵢ · costᵢ(traj)&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;traj* = argmin score  (điểm THẤP nhất)" vertex="1">
          <mxGeometry height="40" width="660" x="470" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=9;spacingLeft=4;spacingTop=4;" value="&lt;b&gt;BaseObstacle&lt;/b&gt;  scale = &lt;b&gt;80.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;Phạt chi phí ô costmap dưới&lt;br&gt;chân quỹ đạo (lethal → +∞ → loại)." vertex="1">
          <mxGeometry height="65" width="218" x="470" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=9;spacingLeft=4;spacingTop=4;" value="&lt;b&gt;PathAlign&lt;/b&gt;  scale = &lt;b&gt;24.0&lt;/b&gt;&lt;br&gt;forward_point_distance = &lt;b&gt;0.4&lt;/b&gt; m&lt;br&gt;Phạt lệch hướng so với&lt;br&gt;đường dẫn /plan." vertex="1">
          <mxGeometry height="65" width="218" x="691" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=9;spacingLeft=4;spacingTop=4;" value="&lt;b&gt;PathDist&lt;/b&gt;  scale = &lt;b&gt;24.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;Phạt khoảng cách ngang&lt;br&gt;từ quỹ đạo đến /plan." vertex="1">
          <mxGeometry height="65" width="218" x="912" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=9;spacingLeft=4;spacingTop=4;" value="&lt;b&gt;GoalAlign&lt;/b&gt;  scale = &lt;b&gt;12.0&lt;/b&gt;&lt;br&gt;forward_point_distance = &lt;b&gt;0.4&lt;/b&gt; m&lt;br&gt;Phạt lệch hướng so với&lt;br&gt;hướng tới goal pose." vertex="1">
          <mxGeometry height="65" width="218" x="470" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=9;spacingLeft=4;spacingTop=4;" value="&lt;b&gt;GoalDist&lt;/b&gt;  scale = &lt;b&gt;24.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;Phạt khoảng cách Euclid&lt;br&gt;từ điểm cuối traj đến goal." vertex="1">
          <mxGeometry height="65" width="218" x="691" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=9;spacingLeft=4;spacingTop=4;" value="&lt;b&gt;RotateToGoal&lt;/b&gt;  scale = &lt;b&gt;32.0&lt;/b&gt;&lt;br&gt;slowing_factor = &lt;b&gt;2.0&lt;/b&gt;  ·  lookahead = −1&lt;br&gt;Khi Δxy &amp;lt; xy_tol → xoay tại chỗ;&lt;br&gt;giảm tốc khi tiếp cận." vertex="1">
          <mxGeometry height="65" width="218" x="912" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=9;spacingLeft=4;spacingTop=4;" value="&lt;b&gt;Oscillation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Phát hiện và phạt quỹ đạo&lt;br&gt;đảo dấu vận tốc liên tiếp." vertex="1">
          <mxGeometry height="65" width="218" x="470" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=9;spacingLeft=4;spacingTop=4;" value="&lt;b&gt;Thứ tự chạy:&lt;/b&gt; RotateToGoal · Oscillation · BaseObstacle · GoalAlign · PathAlign · PathDist · GoalDist&lt;br&gt;short_circuit_trajectory_evaluation = True  →  huỷ chấm ngay khi gặp ô lethal (giảm tải CPU).&lt;br&gt;stateful = True  →  ưu tiên hướng tốt nhất của tick trước để ổn định lựa chọn." vertex="1">
          <mxGeometry height="65" width="439" x="691" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-68" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;④ Best Trajectory → /cmd_vel — Xuất lệnh điều khiển tốt nhất&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Chuyển đổi quỹ đạo điểm thấp nhất → lệnh Twist; publish @ 20 Hz xuống wheel_odom_node.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Sau khi Stage ③ hoàn tất chấm điểm tất cả quỹ đạo sống sót.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) traj*  =  argmin_{traj hợp lệ}  score(traj)&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) (v*, ω*)  ←  vận tốc đầu tiên của traj*  ·  v* ∈ [0.0, 0.4] m/s  ·  ω* ∈ [−1.5, 1.5] rad/s&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Publish  /cmd_vel:  Twist( linear.x = v*,  angular.z = ω* )  mỗi 50 ms&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) stateful = True: lưu hướng tốt nhất → ổn định lựa chọn qua tick tiếp theo (giảm jitter)&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; controller_frequency = &lt;b&gt;20&lt;/b&gt; Hz  ·  min_x_velocity_threshold = &lt;b&gt;0.001&lt;/b&gt;  ·  min_theta_velocity_threshold = &lt;b&gt;0.05&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="660" x="470" y="1325" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;/cmd_vel&lt;/b&gt;  (geometry_msgs/Twist)&lt;br&gt;&lt;i&gt;Đích: wheel_odom_node (STM32 UART)&lt;/i&gt;&lt;br&gt;&lt;br&gt;linear.x  =  v*  ∈  [0.0, 0.4] m/s&lt;br&gt;angular.z  =  ω*  ∈  [−1.5, 1.5] rad/s&lt;br&gt;Tần suất: &lt;b&gt;20 Hz&lt;/b&gt; (mỗi 50 ms)" vertex="1">
          <mxGeometry height="130" width="260" x="1280" y="160" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-70" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C65911;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;DWB — Cơ sở lý thuyết&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Fox et al. 1997, &quot;The Dynamic Window Approach to Collision Avoidance&quot;)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Không gian tìm kiếm:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;V_s  =  V_reachable ∩ V_admissible ∩ [v_min, v_max]&lt;br&gt;&lt;br&gt;&lt;b&gt;V_reachable&lt;/b&gt; = {(v,ω) | v ∈ v_cur ± a·dt}&lt;br&gt;&amp;nbsp;&amp;nbsp;→ ứng viên đạt được trong 1 tick (dt = 0.05 s)&lt;br&gt;&lt;br&gt;&lt;b&gt;V_admissible&lt;/b&gt; = {(v,ω) | robot dừng&lt;br&gt;&amp;nbsp;&amp;nbsp;trước chướng ngại gần nhất}&lt;br&gt;&amp;nbsp;&amp;nbsp;→ DWB xấp xỉ bằng short_circuit_evaluation&lt;br&gt;&lt;br&gt;&lt;b&gt;Hàm mục tiêu (Fox 1997):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;G(v,ω) = σ(α·heading(v,ω)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; + β·dist(v,ω)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; + γ·velocity(v,ω))&lt;br&gt;&amp;nbsp;&amp;nbsp;DWB tổng quát hoá → 7 critic có scale.&lt;br&gt;&lt;br&gt;&lt;b&gt;Độ phức tạp mỗi tick (50 ms):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Samples: 12 × 15 = &lt;b&gt;180&lt;/b&gt; ứng viên&lt;br&gt;&amp;nbsp;&amp;nbsp;Rollout: 1.5/0.05 ≈ &lt;b&gt;30&lt;/b&gt; điểm/quỹ đạo&lt;br&gt;&amp;nbsp;&amp;nbsp;Scoring: 7 × 180 = &lt;b&gt;1 260&lt;/b&gt; phép tính&lt;br&gt;&lt;br&gt;&lt;b&gt;Luồng Nav2:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;bt_navigator → FollowPath action&lt;br&gt;&amp;nbsp;&amp;nbsp;→ controller_server (DWB)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ /cmd_vel → STM32 (wheel ctrl)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ Failure → recoveries_server&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(plugins: wait · spin · backup)" vertex="1">
          <mxGeometry height="530" width="260" x="1280" y="310" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-71" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Màu sắc khối:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;■ Xanh dương — Input ROS topic / TF&lt;br&gt;&amp;nbsp;&amp;nbsp;■ Vàng nhạt — Core container (DWB)&lt;br&gt;&amp;nbsp;&amp;nbsp;■ Trắng/cam — Substep (4 lớp: Mục đích ·&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kích hoạt · Quy trình · Tham số)&lt;br&gt;&amp;nbsp;&amp;nbsp;■ Xanh lá — Output /cmd_vel&lt;br&gt;&amp;nbsp;&amp;nbsp;■ Cam đậm — Theory / Reference&lt;br&gt;&lt;br&gt;&lt;b&gt;Màu đường nối:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;→ Xanh đậm (#2F5496): Input → Core&lt;br&gt;&amp;nbsp;&amp;nbsp;→ Đỏ đậm (#B85450): Luồng ①→②→③→④&lt;br&gt;&amp;nbsp;&amp;nbsp;→ Xanh lá (#82B366): Core → Output&lt;br&gt;&amp;nbsp;&amp;nbsp;─ ─ Tím (#9673A6): Feedback nội bộ&lt;br&gt;&lt;br&gt;&lt;b&gt;Routing gutters (không có khối):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Gutter 1 (x=280–420, 140 px):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x=300 /plan → Stage①(top)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x=320 /tf → Stage②&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x=340 /odom → Stage①(bot)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x=360 Goal → Goal Checker&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x=395 /scan → Costmap&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x=405 /ultrasonic → Costmap&lt;br&gt;&amp;nbsp;&amp;nbsp;Inner margin (x=1110–1140):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x=1120 Costmap → Stage② (dashed)&lt;br&gt;&amp;nbsp;&amp;nbsp;Gutter 2 (x=1140–1260, 120 px):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x=1200 Stage④ → /cmd_vel&lt;br&gt;&lt;br&gt;&lt;b&gt;Nguồn:&lt;/b&gt; nav2_params_test.yaml&lt;br&gt;&lt;b&gt;Bộ điều khiển:&lt;/b&gt; Nav2 Foxy / dwb_core" vertex="1">
          <mxGeometry height="620" width="260" x="1280" y="860" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-72" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.14;entryDx=0;entryDy=0;strokeColor=#2F5496;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=9;labelBackgroundColor=#FFFFFF;" target="7JBYn4sk39azXEOEYMLu-57" value="&lt;span style=&#39;font-size:9px&#39;&gt;reference path&lt;/span&gt;">
