        <mxCell id="eUd0AJZOp9-srg211QHi-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;① Goal Pose&lt;/b&gt; (action goal)&lt;br&gt;&lt;i&gt;geometry_msgs/PoseStamped&lt;/i&gt;&lt;br&gt;Frame: &lt;b&gt;map&lt;/b&gt;&lt;br&gt;Nguồn: BT Navigator gửi qua action client &lt;i&gt;/compute_path_to_pose&lt;/i&gt;.&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; chỉ định tọa độ đích cần đến." vertex="1">
          <mxGeometry height="100" width="260" x="30" y="190" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;② Start Pose&lt;/b&gt; (vị trí robot hiện tại)&lt;br&gt;TF: &lt;b&gt;map → base_footprint&lt;/b&gt;&lt;br&gt;Nguồn: AMCL (Adaptive Monte Carlo Localization).&lt;br&gt;scan_topic: /scan_filtered&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; cung cấp điểm xuất phát cho lập lịch." vertex="1">
          <mxGeometry height="100" width="260" x="30" y="305" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;③ Global Costmap&lt;/b&gt;&lt;br&gt;&lt;i&gt;nav2_costmap_2d::Costmap2D&lt;/i&gt;&lt;br&gt;global_frame: &lt;b&gt;map&lt;/b&gt; · resolution: &lt;b&gt;0.05 m/ô&lt;/b&gt;&lt;br&gt;update_frequency: &lt;b&gt;7.0 Hz&lt;/b&gt; · publish: 2.0 Hz&lt;br&gt;always_send_full_costmap: True&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; lưới chi phí 2D mà A* khuếch tán trên đó." vertex="1">
          <mxGeometry height="110" width="260" x="30" y="420" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;align=left;verticalAlign=top;fontSize=9;spacingLeft=6;spacingTop=3;" value="&lt;b&gt;Static Layer&lt;/b&gt; (plugin)&lt;br&gt;Subscribe: /map (transient_local QoS).&lt;br&gt;Đóng góp giá trị cố định từ bản đồ tĩnh đã build sẵn." vertex="1">
          <mxGeometry height="55" width="260" x="30" y="545" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-49" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;align=left;verticalAlign=top;fontSize=9;spacingLeft=6;spacingTop=3;" value="&lt;b&gt;Obstacle Layer&lt;/b&gt; (plugin)&lt;br&gt;observation_sources: scan&lt;br&gt;topic: /scan_filtered (LaserScan)&lt;br&gt;obstacle_max_range: &lt;b&gt;14.0 m&lt;/b&gt;&lt;br&gt;raytrace_max_range: &lt;b&gt;14.5 m&lt;/b&gt;&lt;br&gt;clearing: True · marking: True" vertex="1">
          <mxGeometry height="100" width="260" x="30" y="615" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-50" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;align=left;verticalAlign=top;fontSize=9;spacingLeft=6;spacingTop=3;" value="&lt;b&gt;Inflation Layer&lt;/b&gt; (plugin)&lt;br&gt;inflation_radius: &lt;b&gt;0.60 m&lt;/b&gt;&lt;br&gt;cost_scaling_factor: &lt;b&gt;2.5&lt;/b&gt;&lt;br&gt;cost(d) = (253−1) · exp(−2.5·(d − r_inscribed))" vertex="1">
          <mxGeometry height="85" width="260" x="30" y="730" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;④ Footprint robot&lt;/b&gt; (đa giác va chạm)&lt;br&gt;[[0.35, 0.32], [0.35, −0.32],&amp;nbsp;[−0.14, −0.32], [−0.14, 0.32]]&lt;br&gt;footprint_padding: &lt;b&gt;0.01 m&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; kiểm va chạm khi A* mở rộng láng giềng." vertex="1">
          <mxGeometry height="105" width="260" x="30" y="830" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;planner_server&lt;/font&gt;&lt;/b&gt;  (Lifecycle Node)&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; action server lập lịch toàn cục cho Nav2.&lt;br&gt;&lt;b&gt;Action server:&lt;/b&gt; /compute_path_to_pose  (msg: &lt;i&gt;ComputePathToPose&lt;/i&gt;)&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; expected_planner_frequency = &lt;b&gt;5.0 Hz&lt;/b&gt;  ·  planner_plugins = [&quot;GridBased&quot;]" vertex="1">
          <mxGeometry height="95" width="660" x="460" y="195" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;b&gt;Plugin &quot;GridBased&quot;  ≡  NavfnPlanner&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;Mục đích:&lt;/b&gt; hiện thực thuật toán NavFn dựa trên lưới — sinh path không va chạm trên global_costmap.&lt;br&gt;&lt;b&gt;Tham số (từ nav2_params_test.yaml):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;plugin           = &lt;b&gt;nav2_navfn_planner/NavfnPlanner&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;use_astar      = &lt;b&gt;true&lt;/b&gt;       (chọn A*, không phải Dijkstra)&lt;br&gt;&amp;nbsp;&amp;nbsp;tolerance       = &lt;b&gt;0.25 m&lt;/b&gt;  (dung sai đích khi trích path)&lt;br&gt;&amp;nbsp;&amp;nbsp;allow_unknown = &lt;b&gt;False&lt;/b&gt;     (không lập lịch qua ô chưa khám phá)" vertex="1">
          <mxGeometry height="140" width="660" x="460" y="305" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;①  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;BUILD NAVIGATION FUNCTION&lt;/font&gt;&lt;/b&gt;  (potential field init)&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; chuẩn bị trường thế năng để A* khuếch tán từ goal về start trên lưới costmap.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; khi nhận yêu cầu ComputePathToPose từ BT Navigator.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Đọc global_costmap → mảng phẳng kích thước W×H ô  (W,H lấy từ map).&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Ánh xạ giá trị ô costmap → chi phí thuật toán:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cost(o)  =  0                          nếu o = FREE_SPACE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cost(o) ∈  (1, 252)                nếu o = INFLATED&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cost(o)  =  COST_OBS (=254)  nếu o = LETHAL  (chặn cứng)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cost(o)  =  ∞                          nếu o = UNKNOWN  &lt;b&gt;(allow_unknown=False)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Khởi tạo ô goal làm nguồn (potential = 0), đẩy vào open-list ưu tiên.&lt;br&gt;&lt;b&gt;Tham số nội bộ:&lt;/b&gt; COST_NEUTRAL = 50, COST_OBS = 254  (nav2_navfn_planner)." vertex="1">
          <mxGeometry height="210" width="660" x="460" y="460" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;②  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;A* GRID SEARCH&lt;/font&gt;&lt;/b&gt;  (use_astar = true)&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; lan truyền potential field từ goal ra toàn lưới, ưu tiên theo hướng start nhờ heuristic Euclid.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; sau Bước ①, lặp đến khi pop ra ô start  HOẶC  open-list rỗng.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Pop ô  n  có  f(n)  nhỏ nhất khỏi open-list, trong đó:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;g(n)  =  potential tích lũy từ goal qua các ô láng giềng (kèm cost ô)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;h(n)  =  ‖n − start‖₂  ·  COST_NEUTRAL    (heuristic Euclid · hằng số, admissible)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;f(n)   =  g(n)  +  h(n)&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Mở rộng 4 láng giềng N/E/S/W của  n. Bỏ qua ô có cost = 254 (lethal).&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Kiểm va chạm theo  &lt;i&gt;footprint&lt;/i&gt;  (đa giác inflated padding 0.01) ⇒ loại bỏ nếu đè vật cản.&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) Cập nhật  g(n&#39;)  nếu  g_new &amp;lt; g_old ; đẩy lại n&#39; vào open-list.&lt;br&gt;&amp;nbsp;&amp;nbsp;(5) Dừng khi pop được ô start ⇒ THÀNH CÔNG  ·  hoặc open-list rỗng ⇒ THẤT BẠI.&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; use_astar = &lt;b&gt;true&lt;/b&gt; , allow_unknown = &lt;b&gt;False&lt;/b&gt;&amp;nbsp;" vertex="1">
          <mxGeometry height="250" width="660" x="460" y="685" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;③  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;GRADIENT DESCENT PATH EXTRACTION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; trích đường đi tối ưu năng lượng từ trường thế năng đã hội tụ ở Bước ②.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; A* THÀNH CÔNG (đã pop ô start).&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Đặt con trỏ  p(0)  tại ô start.&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Tại mỗi bước, chuyển sang ô láng giềng có thế năng thấp nhất:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;p(t+1)  =  arg min_{p&#39; ∈ N(p(t))}  potential(p&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Lặp tới khi  ‖p(t) − goal‖₂  ≤  tolerance.&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; tolerance = &lt;b&gt;0.25 m&lt;/b&gt;   (nav2_params_test.yaml)." vertex="1">
          <mxGeometry height="175" width="660" x="460" y="950" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;④  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;PACK nav_msgs/Path&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; chuẩn hóa đường đi sang dạng tin nhắn Nav2 để consumer (Controller/DWB) sử dụng.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&amp;nbsp;&lt;div&gt;- Ánh xạ mỗi ô (i, j) → Tọa độ thực (x, y) qua  resolution &amp;amp; origin&lt;/div&gt;&lt;div&gt;- Đóng gói thành chuỗi  &lt;i&gt;PoseStamped&lt;/i&gt;  trong frame  &lt;b&gt;map&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Ghi vào  action result  và topic  &lt;i&gt;/plan&lt;/i&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="660" x="460" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;BT Navigator&lt;/font&gt;&lt;/b&gt; (action client / caller)&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; điều phối luồng điều hướng qua Behavior Tree.&lt;br&gt;• Gửi Goal qua /compute_path_to_pose&lt;br&gt;• Nhận Path qua action result&lt;br&gt;• Sau đó gửi /follow_path tới DWB&lt;br&gt;BT XML: navigate_w_replanning_and_recovery" vertex="1">
          <mxGeometry height="135" width="260" x="1270" y="190" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;OUTPUT: &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;nav_msgs/Path&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Frame: &lt;b&gt;map&lt;/b&gt;&lt;br&gt;poses: List&amp;lt;PoseStamped&amp;gt;&lt;br&gt;Topic visualize: /plan&lt;br&gt;Trả về caller qua  action result  của ComputePathToPose." vertex="1">
          <mxGeometry height="120" width="260" x="1270" y="350" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;Controller Server&lt;/font&gt; (DWB)&lt;/b&gt; — tiêu thụ Path&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; lập lịch cục bộ, bám theo path toàn cục.&lt;br&gt;• Nhận Path qua action /follow_path&lt;br&gt;• controller_frequency: &lt;b&gt;20.0 Hz&lt;/b&gt;&lt;br&gt;• Xuất /cmd_vel cho cơ sở di động." vertex="1">
          <mxGeometry height="120" width="260" x="1270" y="495" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;Replanning trigger&lt;/b&gt;&lt;br&gt;BT Navigator tick lại ComputePathToPose ở tần suất ≈ expected_planner_frequency (&lt;b&gt;5 Hz&lt;/b&gt;) , hoặc khi costmap thay đổi / nhánh recovery được kích hoạt." vertex="1">
          <mxGeometry height="90" width="260" x="1270" y="640" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C65911;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;NavFn — Cơ sở lý thuyết&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Bản chất:&lt;/b&gt; A* trên lưới ô vuông với hàm chi phí phi tuyến do Inflation Layer áp đặt ⇒ path tối ưu &lt;b&gt;năng lượng&lt;/b&gt; (chi phí), KHÔNG phải shortest path thuần.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hàm chi phí inflation:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;cost(d) = (253−1) · exp(−k · (d − r_i))&lt;br&gt;&amp;nbsp;&amp;nbsp;k = cost_scaling_factor = &lt;b&gt;2.5&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;r_i = inscribed_radius (xấp xỉ từ footprint)&lt;br&gt;&amp;nbsp;&amp;nbsp;d = khoảng cách tới vật cản gần nhất&lt;br&gt;&lt;br&gt;&lt;b&gt;Heuristic A*:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;h(n) = ‖n − start‖₂ · COST_NEUTRAL&lt;br&gt;&amp;nbsp;&amp;nbsp;Admissible: h ≤ chi phí thực ⇒ A* tối ưu.&lt;br&gt;&lt;br&gt;&lt;b&gt;So sánh use_astar:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;true  → A* (định hướng goal, nhanh hơn)&lt;br&gt;&amp;nbsp;&amp;nbsp;false → Dijkstra (quét toàn lưới, chậm)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tham khảo:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• Mã nguồn: nav2_navfn_planner (Nav2)&lt;br&gt;&amp;nbsp;&amp;nbsp;• Probabilistic Robotics, Thrun et al." vertex="1">
          <mxGeometry height="445" width="260" x="1270" y="750" as="geometry" />
        </mxCell>
        <mxCell id="eUd0AJZOp9-srg211QHi-63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=14;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;br&gt;&lt;b&gt;Màu khối:&lt;/b&gt;  &lt;font color=&quot;#1F4E79&quot;&gt;■&lt;/font&gt; Title  ·  &lt;font color=&quot;#2F5496&quot;&gt;■&lt;/font&gt; Section header  ·  &lt;font color=&quot;#6C8EBF&quot;&gt;■&lt;/font&gt; Input (đầu vào)  ·  &lt;font color=&quot;#0288D1&quot;&gt;■&lt;/font&gt; Sub-component (lớp costmap)  ·  &lt;font color=&quot;#D6B656&quot;&gt;■&lt;/font&gt; Core container (planner_server)  ·  &lt;font color=&quot;#D79B00&quot;&gt;■&lt;/font&gt; Process substep (4-layer pattern)  ·  &lt;font color=&quot;#82B366&quot;&gt;■&lt;/font&gt; Output / consumer  ·  &lt;font color=&quot;#B85450&quot;&gt;■&lt;/font&gt; Trigger note  ·  &lt;font color=&quot;#C65911&quot;&gt;■&lt;/font&gt; Theory reference&lt;br&gt;&lt;b&gt;Đường nối:&lt;/b&gt;  ──▶ liền &lt;font color=&quot;#2F5496&quot;&gt;xanh dương&lt;/font&gt;: Input → Core  ·  ──▶ liền &lt;font color=&quot;#B85450&quot;&gt;đỏ&lt;/font&gt;: luồng nội bộ Core (Bước i → Bước i+1)  ·  ──▶ liền &lt;font color=&quot;#82B366&quot;&gt;xanh lá&lt;/font&gt;: Core → Output  ·  ┄┄▶ đứt &lt;font color=&quot;#9673A6&quot;&gt;tím&lt;/font&gt;: action result / feedback  ·  ┄┄▶ đứt &lt;font color=&quot;#0288D1&quot;&gt;xanh nhạt&lt;/font&gt;: quan hệ thành phần (composition)&lt;br&gt;&lt;b&gt;Nguồn tham số:&lt;/b&gt; tất cả các giá trị in đậm (5.0 Hz, 0.25 m, 0.60 m, 2.5, true, False, 0.05 m/ô, 14.0 m, 14.5 m, 20.0 Hz) trích nguyên văn từ &lt;b&gt;nav2_params_test.yaml&lt;/b&gt;. Hằng số nội bộ NavFn (COST_NEUTRAL=50, COST_OBS=254) lấy từ mã nguồn  nav2_navfn_planner ." vertex="1">
          <mxGeometry height="130" width="1614" x="30" y="1305" as="geometry" />
