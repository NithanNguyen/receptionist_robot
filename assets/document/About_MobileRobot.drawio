        <mxCell id="33u3eQPU6rhDYbHWuPK0-36" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F5496;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" value="INPUTS  —  dữ liệu cảm biến / khung tham chiếu / bản đồ" vertex="1">
          <mxGeometry height="28" width="260" x="50" y="170" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;/&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;scan_filtered&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;sensor_msgs/LaserScan&lt;/i&gt;&lt;br&gt;frame_id: laser_frame&lt;br&gt;Nguồn: laser_filters chain&lt;br&gt;  • box_filter (loại tia trúng thân robot)&lt;br&gt;  • range_filter [0.06 – 15.0 m]&lt;br&gt;  • angular filters (xóa 3 vùng nhiễu)&lt;br&gt;Param AMCL: scan_topic = /scan_filtered" vertex="1">
          <mxGeometry height="110" width="260" x="50" y="830" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;b&gt;TF: odom → base_footprint&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;i&gt;Tham chiếu chuyển động tương đối&lt;/i&gt;&lt;br&gt;Nguồn: ekf_filter_node (robot_localization)&lt;br&gt;EKF hợp nhất wheel_odom + IMU BNO055&lt;br&gt;odom_frame_id = &quot;odom&quot;&lt;br&gt;base_frame_id = &quot;base_footprint&quot;" vertex="1">
          <mxGeometry height="100" width="260" x="50" y="470" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;b&gt;/map&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;i&gt;nav_msgs/OccupancyGrid&lt;/i&gt;&lt;br&gt;frame_id: map  (= global_frame_id)&lt;br&gt;Nguồn: nav2_map_server&lt;div&gt;&lt;div&gt;AMCL tiền xử lý nội bộ →&lt;br&gt;&lt;b&gt;Likelihood Field&lt;/b&gt; (bảng tra khoảng cách):&lt;br&gt;laser_likelihood_max_dist = 2.0 m&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="50" y="350" as="geometry" />
        </mxCell>
        <mxCell id="gHImo0MGDOrfkTz-7T3Y-1" edge="1" parent="1" source="33u3eQPU6rhDYbHWuPK0-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="33u3eQPU6rhDYbHWuPK0-43">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="273" />
              <mxPoint x="390" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;b&gt;Initial Pose&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(179, 179, 179));&quot;&gt;set_initial_pose: &lt;b&gt;True&lt;/b&gt;&lt;br&gt;initial_pose_x   = −0.28527 m&lt;br&gt;initial_pose_y   = −0.159881 m&lt;br&gt;initial_pose_yaw = 2.75943 rad&lt;br&gt;&lt;/font&gt;HOẶC topic &lt;b&gt;/initialpose&lt;/b&gt;&lt;br&gt;(geometry_msgs/PoseWithCov…)&lt;br&gt;phát từ RViz &quot;2D Pose Estimate&quot;" vertex="1">
          <mxGeometry height="115" width="260" x="50" y="215" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;b&gt;TF (static): base_footprint → laser_frame&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;i&gt;Hình học cảm biến&lt;/i&gt;&lt;br&gt;Nguồn: URDF (xacro) qua robot_state_publisher.&lt;br&gt;Dùng để chiếu mỗi tia LiDAR về hệ tọa độ của particle (base)." vertex="1">
          <mxGeometry height="100" width="260" x="50" y="715" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=8;" value="AMCL PARTICLE FILTER  (node: /amcl)" vertex="1">
          <mxGeometry height="1280" width="720" x="450" y="170" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;①  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;PARTICLE INITIALIZATION  (Sampling X₀)&lt;/font&gt;&lt;/b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;Mục đích:&lt;/b&gt; khởi tạo niềm tin ban đầu bel(x₀) cho bộ lọc Bayes — chỉ chạy 1 lần lúc node khởi động hoặc khi nhận pose mới qua /initialpose.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; AMCL node startup &lt;b&gt;HOẶC&lt;/b&gt; topic /initialpose (RViz &quot;2D Pose Estimate&quot;).&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Đọc initial_pose từ params hoặc topic:&amp;nbsp; &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;μ_init&lt;/font&gt; = (−0.28527, −0.159881, 2.75943)&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Sinh N hạt theo Gaussian quanh pose này:&amp;nbsp; &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;xᵢ ~ N(μ_init, Σ_init)&lt;/font&gt;, i = 1..N&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Gán trọng số đồng đều:&amp;nbsp; &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;wᵢ &lt;/font&gt;= 1/N&lt;br&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(179, 179, 179));&quot;&gt;&lt;b&gt;Tham số:&lt;/b&gt;&amp;nbsp; min_particles = &lt;b&gt;500&lt;/b&gt;,&amp;nbsp; max_particles = &lt;b&gt;2000&lt;/b&gt;,&amp;nbsp; recovery_alpha_slow = recovery_alpha_fast = 0 (tắt Augmented MCL — không bơm pose ngẫu nhiên toàn bản đồ).&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="660" x="480" y="215" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;②  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;MOTION UPDATE — Sample Motion Model&lt;/font&gt; (odometry, diff drive)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; bước &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;Predict&lt;/font&gt; của Bayes filter — đẩy mỗi hạt đi theo chuyển động đo bằng odometry, có cộng nhiễu để mô phỏng sai số bánh xe (trượt, lệch trục).&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt;&amp;nbsp; |Δd| ≥ update_min_d = 0.1 m&amp;nbsp;&amp;nbsp; &lt;b&gt;HOẶC&lt;/b&gt;&amp;nbsp;&amp;nbsp; |Δθ| ≥ update_min_a = 0.1 rad&lt;br&gt;&lt;b&gt;Quy trình&lt;/b&gt; (Probabilistic Robotics, Bảng 5.6):&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Đọc và phân rã gia số odometry:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;uₜ&lt;/font&gt; = TF_odomₜ ⊖ TF_odomₜ₋₁&amp;nbsp; ≡&amp;nbsp; (δ_rot1 , δ_trans , δ_rot2)&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Tính phương sai nhiễu Gauss cho từng thành phần:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;σ²_rot1&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;nbsp; α1·δ_rot1²&amp;nbsp;&amp;nbsp;&amp;nbsp;+&amp;nbsp; α2·δ_trans²&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;σ²_trans&amp;nbsp;&amp;nbsp;=&amp;nbsp; α3·δ_trans²&amp;nbsp; +&amp;nbsp; α4·(δ_rot1² + δ_rot2²)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;σ²_rot2&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;nbsp; α1·δ_rot2²&amp;nbsp;&amp;nbsp;&amp;nbsp;+&amp;nbsp; α2·δ_trans²&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Với mỗi hạt i, lấy mẫu pose mới:&amp;nbsp; &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;xᵢᵗ&lt;/font&gt; ← sample( p(xᵗ | xᵢᵗ⁻¹, uₜ) )&lt;br&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(179, 179, 179));&quot;&gt;&lt;b&gt;Tham số:&lt;/b&gt;&amp;nbsp; α1 = &lt;b&gt;0.5&lt;/b&gt;,&amp;nbsp; α2 = &lt;b&gt;0.3&lt;/b&gt;,&amp;nbsp; α3 = &lt;b&gt;0.3&lt;/b&gt;,&amp;nbsp; α4 = &lt;b&gt;0.5&lt;/b&gt;&amp;nbsp;&amp;nbsp;(α5 = 0.3 — không dùng cho diff drive)&lt;/font&gt;" vertex="1">
          <mxGeometry height="210" width="660" x="480" y="400" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;③  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;MEASUREMENT UPDATE — Likelihood Field Range Finder Model&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; bước &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;Correct&lt;/font&gt; của Bayes filter — đánh giá mỗi hạt khớp với LiDAR scan thực đến đâu, &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;gán trọng số&lt;/font&gt; tương ứng (hạt khớp tốt → wᵢ cao; hạt sai lệch → wᵢ ≈ 0).&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; sau mỗi bước ② khi có scan mới trên /scan_filtered.&lt;br&gt;&lt;b&gt;Quy trình&lt;/b&gt; (Probabilistic Robotics, Bảng 6.3):&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Lấy mẫu con tia: chọn &lt;b&gt;max_beams = 120&lt;/b&gt; tia đều từ scan; lọc tia ngoài [laser_min_range = 0.07 m,&amp;nbsp; laser_max_range = 14.9 m].&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Với mỗi hạt xᵢ và mỗi tia k:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– Chiếu điểm trúng &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;zₖ&lt;/font&gt; vào hệ map qua &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;xᵢ ∘ TF(base→laser)&lt;/font&gt;.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– Tra cứu khoảng cách Euclid &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;d&lt;/font&gt; tới chướng ngại gần nhất trong likelihood field (cached, laser_likelihood_max_dist = 2.0 m).&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– Tính xác suất tia (hỗn hợp 4 thành phần, Σ trọng số = 1.0):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;p(zₖ|xᵢ,m)&lt;/font&gt; = z_hit·N(d; 0, σ²_hit) + z_short·λ·exp(−λ·zₖ) + z_max·I(zₖ = z_max_rng) + z_rand·(1/z_max_rng)&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) &lt;b&gt;Beam-skip&lt;/b&gt; (do_beamskip = True): loại tia bị vật cản di động che (kính, người, vật mới); cơ chế tự vô hiệu nếu tỉ lệ tia bị skip vượt ngưỡng lỗi.&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) Cập nhật &amp;amp; chuẩn hóa trọng số:&amp;nbsp; &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;wᵢ ← wᵢ · ∏ₖ p(zₖ | xᵢ, m);&amp;nbsp;&amp;nbsp; wᵢ ← wᵢ / Σⱼ wⱼ&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(179, 179, 179));&quot;&gt;&lt;b&gt;Tham số:&lt;/b&gt;&amp;nbsp; z_hit = &lt;b&gt;0.7&lt;/b&gt;,&amp;nbsp; z_short = &lt;b&gt;0.05&lt;/b&gt;,&amp;nbsp; z_max = &lt;b&gt;0.05&lt;/b&gt;,&amp;nbsp; z_rand = &lt;b&gt;0.2&lt;/b&gt;;&amp;nbsp; σ_hit = 0.2 m,&amp;nbsp; λ = lambda_short = 0.1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; beam_skip_distance = 0.3 m,&amp;nbsp; beam_skip_threshold = 0.3,&amp;nbsp; beam_skip_error_threshold = 0.9&lt;/font&gt;" vertex="1">
          <mxGeometry height="310" width="660" x="480" y="635" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;④  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;KLD-ADAPTIVE RESAMPLING&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;loại hạt yếu, nhân bản hạt mạnh&lt;/font&gt; — tập trung niềm tin vào vùng có xác suất cao. Đồng thời điều chỉnh số hạt N theo phân kỳ Kullback–Leibler để cân bằng độ chính xác và tải CPU.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; mỗi &lt;b&gt;resample_interval = 2&lt;/b&gt; chu kỳ lọc (sau ③). Tần suất thưa giúp tránh particle deprivation — mất đa dạng do resample quá thường.&lt;br&gt;&lt;b&gt;Quy trình&lt;/b&gt; (Fox, IJRR 2003 — KLD-Sampling):&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Thực hiện systematic (low-variance) resampling từ phân phối {wᵢ}.&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Trong khi lấy mẫu, đếm k = số bin pose chiếm chỗ; chọn số hạt mới N* sao cho KL(p̂‖p) ≤ pf_err với độ tin cậy pf_z.&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Kẹp &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;N*&lt;/font&gt; trong [min_particles, max_particles].&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) Reset trọng số đều cho tập mới:&amp;nbsp; &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;wᵢ = 1/N*&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(179, 179, 179));&quot;&gt;&lt;b&gt;Tham số:&lt;/b&gt;&amp;nbsp; pf_err = &lt;b&gt;0.05&lt;/b&gt; (sai số mục tiêu),&amp;nbsp; pf_z = &lt;b&gt;0.99&lt;/b&gt; (độ tin cậy 99%),&amp;nbsp; resample_interval = &lt;b&gt;2&lt;/b&gt;,&amp;nbsp; N ∈ [&lt;b&gt;500&lt;/b&gt;, &lt;b&gt;2000&lt;/b&gt;]&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="660" x="480" y="970" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;⑤  &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;POSE ESTIMATION — Cluster Mean &amp;amp; Covariance&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt;&amp;nbsp;&lt;div&gt;- Trích xuất pose ước lượng duy nhất + hiệp phương sai từ tập hạt,&lt;/div&gt;&lt;div&gt;- Phát TF map→odom hoàn tất chuỗi TF cho Nav2 stack.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;b&gt;- Không sửa tập hạt&lt;/b&gt; (không thuộc vòng lặp Bayes nội bộ).&lt;br&gt;&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; sau mỗi chu kỳ filter (sau ④); ngoài ra save_pose_rate = 0.5 Hz lưu pose vào parameter server (phục hồi sau restart).&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) Phân cụm các hạt theo vị trí.&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Chọn cụm có tổng Σwᵢ lớn nhất.&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) Tính pose trung bình có trọng số ( x̂ , ŷ , θ̂ ) và ma trận hiệp phương sai 6×6.&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) Tính &amp;amp; phát TF:&amp;nbsp; T_map→odom = T_map→base · ( T_odom→base )⁻¹&lt;br&gt;&amp;nbsp;&amp;nbsp;(5) Publish&amp;nbsp; /amcl_pose,&amp;nbsp; /particle_cloud,&amp;nbsp; TF (map → odom).&lt;br&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(179, 179, 179));&quot;&gt;&lt;b&gt;Tham số:&lt;/b&gt;&amp;nbsp; tf_broadcast = &lt;b&gt;True&lt;/b&gt;,&amp;nbsp; transform_tolerance = &lt;b&gt;0.5 s&lt;/b&gt;,&amp;nbsp; save_pose_rate = &lt;b&gt;0.5 Hz&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="660" x="480" y="1185" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#385723;strokeColor=#1F3D12;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" value="OUTPUTS  —  pose, TF, particle cloud" vertex="1">
          <mxGeometry height="28" width="260" x="1290" y="170" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C65911;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;spacingBottom=4;" value="&lt;b&gt;BAYES FILTER — Lý thuyết nền&lt;/b&gt;&lt;br&gt;&lt;br&gt;Niềm tin về pose tại thời điểm t:&lt;br&gt;&amp;nbsp;&amp;nbsp; bel(xₜ) = p(xₜ | z₁:ₜ, u₁:ₜ, m)&lt;br&gt;&lt;br&gt;&lt;b&gt;Đệ quy 2 bước:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;Predict (≡ bước ②):&lt;br&gt;&amp;nbsp;&amp;nbsp; bel̄(xₜ) = ∫ p(xₜ|xₜ₋₁, uₜ)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; · bel(xₜ₋₁) dxₜ₋₁&lt;br&gt;&lt;br&gt;&amp;nbsp;Update (≡ bước ③):&lt;br&gt;&amp;nbsp;&amp;nbsp; bel(xₜ) = η · p(zₜ|xₜ, m) · bel̄(xₜ)&lt;br&gt;&amp;nbsp;&amp;nbsp; η:&amp;nbsp;hằng số chuẩn hóa (Σwᵢ = 1)&lt;br&gt;&lt;br&gt;&lt;b&gt;Trong AMCL,&lt;/b&gt; bel được xấp xỉ bằng tập N hạt:&lt;br&gt;&amp;nbsp;&amp;nbsp; bel(xₜ) ≈ { (xᵢᵗ, wᵢᵗ) }, i = 1..N&lt;br&gt;&lt;br&gt;Ánh xạ phương trình → mô hình:&lt;br&gt;&amp;nbsp;• p(xₜ|xₜ₋₁, uₜ) → &lt;i&gt;Sample Motion&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;Model&lt;/i&gt; — hiện thực ở bước ②&lt;br&gt;&amp;nbsp;• p(zₜ|xₜ, m) → &lt;i&gt;Likelihood Field&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;Range Finder Model&lt;/i&gt; — bước ③&lt;br&gt;&lt;br&gt;&lt;b&gt;④&lt;/b&gt; KLD-Sampling: điều chỉnh N theo độ tập trung của niềm tin.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑤&lt;/b&gt; Pose Estimation: trích pose từ phân phối — không sửa bel, không thuộc vòng lặp Bayes.&lt;br&gt;&lt;br&gt;&lt;i&gt;Tài liệu:&lt;/i&gt;&lt;br&gt;&amp;nbsp;• Thrun-Burgard-Fox,&lt;br&gt;&amp;nbsp;&amp;nbsp; &lt;i&gt;Probabilistic Robotics&lt;/i&gt; (MIT, 2005)&lt;br&gt;&amp;nbsp;• Fox D., &lt;i&gt;KLD-Sampling&lt;/i&gt; (IJRR, 2003)" vertex="1">
          <mxGeometry height="735" width="260" x="1290" y="210" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;b&gt;/particle_cloud&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;i&gt;nav2_msgs/ParticleCloud&lt;/i&gt;&lt;br&gt;frame_id: map&lt;br&gt;Toàn bộ tập hạt (debug, RViz).&lt;br&gt;Trải rộng khi mới khởi tạo hoặc&lt;br&gt;robot bị &quot;kidnapped&quot;; hội tụ về&lt;br&gt;một cụm chặt khi đã định vị tốt." vertex="1">
          <mxGeometry height="140" width="260" x="1290" y="995" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;b&gt;/amcl_pose&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;i&gt;geometry_msgs/&lt;br&gt;PoseWithCovarianceStamped&lt;/i&gt;&lt;br&gt;frame_id: map&lt;br&gt;Phát mỗi chu kỳ filter (sau ⑤).&lt;br&gt;→ Tiêu thụ bởi: BT Navigator, Costmap2D (rolling), RViz." vertex="1">
          <mxGeometry height="111" width="260" x="1290" y="1185" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(234, 107, 102));&quot;&gt;&lt;b&gt;TF: map → odom&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;i&gt;Hiệu chỉnh trôi của odometry&lt;/i&gt;&lt;br&gt;tf_broadcast = True;  transform_tolerance = 0.5 s" vertex="1">
          <mxGeometry height="60" width="260" x="1290" y="1310" as="geometry" />
        </mxCell>
