        <mxCell id="oGh2IvK_3FmeeXT8ehG_-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F5496;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="OUTPUTS" vertex="1">
          <mxGeometry height="30" width="340" x="1255" y="90" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;① THAM SỐ DÒNG LỆNH&lt;/b&gt; (argparse, dòng 338–352)&lt;br&gt;&lt;b&gt;Vai trò:&lt;/b&gt; giao diện; giá trị trỏ tới 2 lớp dữ liệu.&lt;br&gt;• &lt;b&gt;--bag&lt;/b&gt; ✓  thư mục bag (metadata.yaml)&lt;br&gt;• &lt;b&gt;--map&lt;/b&gt; ✓  map_&lt;floor&gt;.yaml&lt;br&gt;• --out (./bag_path_out)&lt;br&gt;• --map / odom / base-frame (map / odom / base_footprint)&lt;br&gt;• --start-marker (navigating | computing)&lt;br&gt;• --per-segment-png (flag)&lt;br&gt;&lt;b&gt;Validate:&lt;/b&gt; --bag là thư mục (354); --map tồn tại (356)" vertex="1">
          <mxGeometry height="180" width="335" x="20" y="140" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;③ FILE BẢN ĐỒ SLAM&lt;/b&gt; (load_map, 130–153)  ← --map&lt;br&gt;&lt;b&gt;map_&lt;floor&gt;.yaml&lt;/b&gt; — đọc 3 khóa:&lt;br&gt;  • image (134) → đường dẫn ảnh (tương đối theo yaml)&lt;br&gt;  • resolution (151) — m/px&lt;br&gt;  • origin [x,y,yaw] (152) — pixel góc dưới–trái&lt;br&gt;&lt;b&gt;Ảnh:&lt;/b&gt; .pgm P5/P2 (82–127) | .png (143) → chuẩn hóa 0..1&lt;br&gt;&lt;b&gt;Bỏ qua:&lt;/b&gt; negate, occupied/free_thresh" vertex="1">
          <mxGeometry height="150" width="335" x="20" y="340" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;② NỘI DUNG BAG ROS 2&lt;/b&gt; (iter_bag, 159–202)  ← --bag&lt;br&gt;&lt;b&gt;Cấu trúc:&lt;/b&gt; metadata.yaml (storage_id 161–166) + *.db3&lt;br&gt;&lt;b&gt;Topic đọc:&lt;/b&gt;&lt;br&gt;  • /tf , /tf_static → TFMessage (233)&lt;br&gt;  • /robot/status_message → String (248)&lt;br&gt;&lt;b&gt;/tf dùng 2 cặp:&lt;/b&gt; map→odom (241, AMCL); odom→base_footprint (243, EKF)&lt;br&gt;&lt;b&gt;Trường:&lt;/b&gt; translation.x/y ; rotation.x/y/z/w&lt;br&gt;&lt;b&gt;Bỏ qua:&lt;/b&gt; /amcl_pose, /robot/state (lệch docstring 19–20)" vertex="1">
          <mxGeometry height="180" width="335" x="20" y="510" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;④ TIỀN ĐỀ MÔI TRƯỜNG&lt;/b&gt; (input ngầm)&lt;br&gt;&lt;b&gt;ROS 2 (source):&lt;/b&gt; rclpy, rosbag2_py, rosidl_runtime_py (174–176)&lt;br&gt;&lt;b&gt;pip:&lt;/b&gt; numpy, matplotlib(Agg), pyyaml (47–52)&lt;br&gt;⚠ Thiếu ROS → iter_bag() không chạy được" vertex="1">
          <mxGeometry height="110" width="335" x="20" y="710" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;②′ CHUỖI /robot/status_message → regex&lt;/b&gt; (208–211)&lt;br&gt;&lt;b&gt;START_RE&lt;/b&gt; (208): &quot;Navigating → [id] &#39;name&#39;&quot; (navigator 801)&lt;br&gt;&lt;b&gt;COMPUTE_RE&lt;/b&gt; (209): &quot;Computing path…[id] &#39;name&#39;&quot; (623)&lt;br&gt;&lt;b&gt;END_RE&lt;/b&gt; (210): Arrived|At Home|Aborted|canceled|CRITICAL|rejected|IDLE&lt;br&gt;→ mốc bắt đầu/kết thúc mỗi chặng (extract 248–254)" vertex="1">
          <mxGeometry height="120" width="335" x="20" y="840" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=8;" value="PIPELINE bag_to_path.py (main điều phối, thứ tự thực thi ①→④)" vertex="1">
          <mxGeometry height="760" width="640" x="495" y="115" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;main()&lt;/b&gt; (338–394)&lt;br&gt;&lt;b&gt;Vai trò:&lt;/b&gt; parse + validate cờ CLI, điều phối 4 bước.&lt;br&gt;&lt;b&gt;Đọc:&lt;/b&gt; toàn bộ tham số dòng lệnh&lt;br&gt;&lt;b&gt;Gọi:&lt;/b&gt; load_map → extract → build_segments → draw" vertex="1">
          <mxGeometry height="95" width="600" x="515" y="150" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;① load_map()&lt;/b&gt; (130–153)&lt;br&gt;&lt;b&gt;Đọc:&lt;/b&gt; --map (yaml + ảnh)&lt;br&gt;&lt;b&gt;Sinh:&lt;/b&gt; img(0..1), resolution, origin" vertex="1">
          <mxGeometry height="85" width="600" x="515" y="265" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;iter_bag()&lt;/b&gt; (172–202) [cần ROS]&lt;br&gt;&lt;b&gt;Đọc:&lt;/b&gt; --bag qua rosbag2_py (SequentialReader)&lt;br&gt;&lt;b&gt;Sinh:&lt;/b&gt; (topic, msg, t_ns) cho mỗi message&lt;br&gt;⚠ Chưa test ở sandbox (thiếu rosbag2_py)" vertex="1">
          <mxGeometry height="110" width="600" x="515" y="370" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;② extract()&lt;/b&gt; (214–257)&lt;br&gt;&lt;b&gt;Đọc:&lt;/b&gt; stream iter_bag + --*-frame + --start-marker&lt;br&gt;&lt;b&gt;Xử lý:&lt;/b&gt; /tf → compose map→base (quat_to_yaw 58; compose_2d 63);&lt;br&gt;  /status → regex tách mốc chặng&lt;br&gt;&lt;b&gt;Sinh:&lt;/b&gt; traj[N×4]=(t,x,y,yaw), starts[], ends[]" vertex="1">
          <mxGeometry height="120" width="600" x="515" y="500" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;③ build_segments()&lt;/b&gt; (260–276)&lt;br&gt;&lt;b&gt;Đọc:&lt;/b&gt; traj, starts, ends&lt;br&gt;&lt;b&gt;Sinh:&lt;/b&gt; các chặng [start_i , end_i)" vertex="1">
          <mxGeometry height="90" width="600" x="515" y="640" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;④ draw_overview / draw_segment / np.savetxt&lt;/b&gt;&lt;br&gt;  (289–332, 377–382)&lt;br&gt;&lt;b&gt;Đọc:&lt;/b&gt; img + traj + segs&lt;br&gt;&lt;b&gt;Sinh:&lt;/b&gt; ảnh PNG + CSV" vertex="1">
          <mxGeometry height="100" width="600" x="515" y="750" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C65911;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;THAM CHIẾU: pose map→base_footprint&lt;/b&gt;&lt;br&gt;Ghép 2 TF (compose_2d, 63–76):&lt;br&gt;  x = ax + cos(θa)·bx − sin(θa)·by&lt;br&gt;  y = ay + sin(θa)·bx + cos(θa)·by&lt;br&gt;  θ = wrap(θa + θb)&lt;br&gt;với a = map→odom (AMCL),&lt;br&gt;      b = odom→base (EKF)&lt;br&gt;yaw ← quaternion (58–60):&lt;br&gt;  θ = atan2(2(wz+xy), 1 − 2(y² + z²))" vertex="1">
          <mxGeometry height="240" width="340" x="1255" y="140" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;CSV&lt;/b&gt;&lt;br&gt;• full_path.csv (t_sec,x,y,yaw)&lt;br&gt;• segments/seg_XX_cp&lt;ID&gt;.csv&lt;br&gt;&lt;i&gt;→ dùng cho metrics của paper&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="1255" y="470" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;PNG&lt;/b&gt;&lt;br&gt;• overview.png (map + path + chặng tô màu)&lt;br&gt;• segments/seg_XX_cp&lt;ID&gt;.png&lt;br&gt;&lt;i&gt;(nếu bật --per-segment-png)&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="1255" y="650" as="geometry" />
        </mxCell>
        <mxCell id="oGh2IvK_3FmeeXT8ehG_-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;  xanh dương = input | vàng = lõi xử lý | xanh lá = output | cam = tham chiếu   &lt;b&gt;Cạnh:&lt;/b&gt; xanh = input→lõi  đỏ = luồng dữ liệu trong lõi  xanh lá = lõi→output&lt;br&gt;&lt;b&gt;LƯU Ý KHOA HỌC VỀ INPUT:&lt;/b&gt;&lt;br&gt;(1) t_sec = thời gian &lt;b&gt;ghi bag&lt;/b&gt; (read_next, 197/231), KHÔNG phải header.stamp → trễ nhẹ khi tính latency.&lt;br&gt;(2) Chỉ 2D: bỏ z; yaw suy từ quaternion (239–240, 58–60).&lt;br&gt;(3) Pose chỉ sinh khi có CẢ map→odom VÀ odom→base (244); thiếu → traj rỗng, thoát (370–372).&lt;br&gt;(4) latest_map_odom giữ giá trị cũ khi AMCL ngừng → path nối &quot;mù&quot; (dead-reckoning), KHÔNG tự cụt.&lt;br&gt;(5) --*-frame phải khớp TF thật (vd base_link vs base_footprint), sai → traj rỗng." vertex="1">
          <mxGeometry height="165" width="1575" x="20" y="980" as="geometry" />
        </mxCell>
