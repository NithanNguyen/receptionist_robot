        <mxCell id="33u3eQPU6rhDYbHWuPK0-62" edge="1" parent="1" source="33u3eQPU6rhDYbHWuPK0-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B85450;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=9;labelBackgroundColor=#FFFFFF;" target="33u3eQPU6rhDYbHWuPK0-47" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); background-color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;Xₜ  (đã resample, w đều)&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-63" edge="1" parent="1" source="33u3eQPU6rhDYbHWuPK0-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=light-dark(#000000,#CC0000);strokeWidth=1.5;endArrow=classic;endFill=1;dashed=1;fontSize=9;labelBackgroundColor=#FFF2CC;" target="33u3eQPU6rhDYbHWuPK0-44" value="&lt;span style=&quot;background-color: light-dark(rgb(255, 242, 204), rgb(234, 107, 102));&quot;&gt;Tập hạt cho chu kỳ Bayes filter kế tiếp&lt;/span&gt;">
          <mxGeometry relative="1" x="-0.2203" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="1155" y="1065" />
              <mxPoint x="1155" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-64" edge="1" parent="1" source="33u3eQPU6rhDYbHWuPK0-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82B366;strokeWidth=1.5;endArrow=classic;endFill=1;" target="33u3eQPU6rhDYbHWuPK0-50">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1290" y="1065" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-65" edge="1" parent="1" source="33u3eQPU6rhDYbHWuPK0-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;strokeColor=#82B366;strokeWidth=1.5;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="1247" />
              <mxPoint x="1250" y="1241" />
              <mxPoint x="1290" y="1241" />
            </Array>
            <mxPoint x="1290" y="1241" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-66" edge="1" parent="1" source="33u3eQPU6rhDYbHWuPK0-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82B366;strokeWidth=1.5;endArrow=classic;endFill=1;" target="33u3eQPU6rhDYbHWuPK0-52">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1140" y="1325" />
              <mxPoint x="1230" y="1325" />
              <mxPoint x="1230" y="1340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;spacingBottom=4;" value="&lt;b&gt;Ghi chú khoa học&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Thuật toán&lt;/b&gt;: AMCL = Adaptive Monte Carlo Localization (Fox, 2003) — kết hợp MCL + KLD-Sampling.&lt;br&gt;• &lt;b&gt;Mô hình chuyển động&lt;/b&gt;: Sample Motion Model Odometry (Thrun–Burgard–Fox, &lt;i&gt;Probabilistic Robotics&lt;/i&gt; 2005, §5.4 / Bảng 5.6).&lt;br&gt;• &lt;b&gt;Mô hình cảm biến&lt;/b&gt;: Likelihood Field Range Finder Model (cùng tài liệu, §6.4 / Bảng 6.3) — mịn và rẻ hơn beam model.&lt;br&gt;• &lt;b&gt;Vòng lặp Bayes filter&lt;/b&gt;: Predict (②) → Update (③) → Resample (④). Bước ⑤ (Pose Estimation) &lt;b&gt;không&lt;/b&gt; tham gia vòng lặp nội bộ.&lt;br&gt;• &lt;b&gt;Khác biệt nav2_params_test.yaml so với nav2_params.yaml&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– set_initial_pose:&amp;nbsp;&amp;nbsp;False → &lt;b&gt;True&lt;/b&gt; (bypass thao tác RViz)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– z_hit / z_rand:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0.5 / 0.4 → &lt;b&gt;0.7 / 0.2&lt;/b&gt; (tin tưởng vào bản đồ tĩnh hơn, ít chấp nhận đo nhiễu)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– resample_interval: 1 → &lt;b&gt;2&lt;/b&gt; (giảm mất đa dạng hạt)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– transform_tolerance: 0.2 → &lt;b&gt;0.5 s&lt;/b&gt; (rộng rãi hơn cho TF chậm)&lt;br&gt;&lt;br&gt;&lt;b&gt;Quy ước màu&lt;/b&gt;:&amp;nbsp; xanh dương = INPUT,&amp;nbsp; vàng = CORE filter,&amp;nbsp; xanh lá = OUTPUT,&amp;nbsp; cam = lý thuyết,&amp;nbsp; đỏ = luồng dữ liệu chính,&amp;nbsp; tím nét đứt = feedback (vòng lặp Bayes)." vertex="1">
          <mxGeometry height="285" width="380" x="40" y="975" as="geometry" />
        </mxCell>
        <mxCell id="33u3eQPU6rhDYbHWuPK0-68" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;spacingBottom=4;" value="&lt;b&gt;TF Tree — sau khi AMCL phát map → odom&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;map ──► odom ──► base_footprint ──► base_link ──► laser_frame&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ robot_state_publisher (URDF)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ ekf_filter_node (~50 Hz)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ &lt;b&gt;AMCL&lt;/b&gt; (tf_broadcast = True; cập nhật mỗi chu kỳ filter)&lt;br&gt;&lt;br&gt;&lt;b&gt;Quy ước tham số AMCL:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp; global_frame_id&amp;nbsp;&amp;nbsp;= &quot;map&quot;&amp;nbsp;&amp;nbsp;(cố định toàn cục)&lt;br&gt;&amp;nbsp;&amp;nbsp; odom_frame_id&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= &quot;odom&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp; base_frame_id&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= &quot;base_footprint&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ý nghĩa:&lt;/b&gt; AMCL chỉ phát &lt;b&gt;1 khâu&lt;/b&gt; trong chuỗi TF — chính là khâu hiệu chỉnh trôi của odometry (map → odom). Trước khi AMCL chạy, chuỗi TF từ map về robot &lt;b&gt;không khép kín&lt;/b&gt; → costmap toàn cục không hoạt động được." vertex="1">
          <mxGeometry height="280" width="380" x="40" y="1275" as="geometry" />
        </mxCell>
        <mxCell id="gHImo0MGDOrfkTz-7T3Y-2" edge="1" parent="1" source="33u3eQPU6rhDYbHWuPK0-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.002;entryY=0.808;entryDx=0;entryDy=0;entryPerimeter=0;" target="33u3eQPU6rhDYbHWuPK0-45">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
