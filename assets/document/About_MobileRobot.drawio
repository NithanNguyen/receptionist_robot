        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;robot_state_publisher&lt;/b&gt;  [t=0.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; phát TF tĩnh của robot từ URDF (base_link, laser_frame, bánh xe...).&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; robot_state_publisher · &lt;b&gt;exec:&lt;/b&gt; robot_state_publisher&lt;br&gt;&lt;b&gt;File mô hình:&lt;/b&gt; urdf/mobile_robot.urdf.xacro (nạp qua lệnh xacro)&lt;br&gt;&lt;b&gt;Pub:&lt;/b&gt; /robot_description, /tf_static · publish_frequency=&lt;b&gt;50.0&lt;/b&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="440" x="110" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;wheel_odom_node&lt;/b&gt;  [t=0.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; đọc packet STM32 qua UART → tính &amp;amp; Pub /odom; nhận /cmd_vel → gửi speed/steer xuống STM32.&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; mobile_robot · &lt;b&gt;exec:&lt;/b&gt; wheel_odom_node.py&lt;br&gt;&lt;b&gt;Config:&lt;/b&gt; config/wheel_odom_params.yaml · publish_tf=&lt;b&gt;false&lt;/b&gt; (EKF lo TF)&lt;br&gt;&lt;b&gt;HW:&lt;/b&gt; WHEEL_RADIUS=&lt;b&gt;0.084&lt;/b&gt;m, WHEEL_BASE=&lt;b&gt;0.464&lt;/b&gt;m, MOTOR_MAX_RPM=&lt;b&gt;40&lt;/b&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="435" x="575" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;bno055&lt;/b&gt;  [t=0.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; driver IMU BNO055 (I2C bus 8) → Pub dữ liệu IMU (~50 Hz).&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; bno055 · &lt;b&gt;exec:&lt;/b&gt; bno055&lt;br&gt;&lt;b&gt;Config:&lt;/b&gt; config/bno055_params.yaml · &lt;b&gt;remap&lt;/b&gt; /imu/imu → /imu/data&lt;br&gt;&lt;b&gt;Pub:&lt;/b&gt; /imu/data&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="440" x="110" y="690" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;sllidar_node&lt;/b&gt;  [t=0.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; driver RPLIDAR S2E (kết nối UDP) → Pub /scan. &lt;b&gt;respawn=True&lt;/b&gt; (tự khởi động lại nếu rớt).&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; sllidar_ros2 · &lt;b&gt;exec:&lt;/b&gt; sllidar_node&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt; udp_ip=192.168.11.2, port=8089, frame=laser_frame, scan_mode=Sensitivity&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="435" x="575" y="690" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;ros2 bag record&lt;/b&gt;  [t=0.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; ghi dữ liệu thí nghiệm ra bag để phân tích sau. Bỏ qua nếu record_bag≠true.&lt;br&gt;&lt;b&gt;Loại:&lt;/b&gt; ExecuteProcess (dựng bằng OpaqueFunction → lấy timestamp lúc chạy)&lt;br&gt;&lt;b&gt;Path:&lt;/b&gt; ~/mbrobot_ws/bags/s{scenario}_run{run}_{YYYYMMDD_HHMMSS}&lt;br&gt;&lt;b&gt;12 topic:&lt;/b&gt; /scan, /scan_filtered, /odom, /odometry/filtered, /imu/data, /amcl_pose, /cmd_vel, /tf, /tf_static, /ultrasonic_scan, /robot/state, /robot/status_message&lt;br&gt;&lt;i&gt;src: nav_v3_launch.py:134–180, 457&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="440" x="110" y="855" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#B03A2E;dashed=1;dashPattern=6 4;fontColor=#7B241C;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;jetson_sensor_bridge&lt;/b&gt;  [t=0.0s]  —  &lt;b&gt;DISABLED&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;Trạng thái:&lt;/b&gt; BỊ COMMENT trong LaunchDescription (dòng &lt;b&gt;462&lt;/b&gt;) → KHÔNG chạy.&lt;br&gt;&lt;b&gt;Vai trò (nếu bật):&lt;/b&gt; đọc UART siêu âm → Pub /ultrasonic/&amp;lt;name&amp;gt; (sensor_msgs/Range), respawn=True.&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; mobile_robot · &lt;b&gt;exec:&lt;/b&gt; jetson_sensor_bridge.py&lt;br&gt;&lt;i&gt;src: định nghĩa :254–266 · vô hiệu :462&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="435" x="575" y="855" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;joint_state_publisher&lt;/b&gt;  [t=1.5s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Pub /joint_states cho các khớp (bánh xe) để robot_state_publisher dựng phần TF động.  &amp;nbsp;&lt;b&gt;Gói:&lt;/b&gt; joint_state_publisher · &lt;b&gt;exec:&lt;/b&gt; joint_state_publisher&lt;br&gt;&lt;b&gt;Lịch:&lt;/b&gt; TimerAction period=1.5s.&amp;nbsp;" vertex="1">
          <mxGeometry height="120" width="900" x="110" y="1075" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;imu_reader&lt;/b&gt;  [t=3.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; chuyển quaternion IMU → góc Euler (phục vụ theo dõi/log). Node phụ trợ, KHÔNG nằm trong vòng điều khiển/định vị chính.&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; mobile_robot · &lt;b&gt;exec:&lt;/b&gt; imu_reader.py · &lt;b&gt;Sub:&lt;/b&gt; /imu/data · &lt;b&gt;Pub:&lt;/b&gt; /imu/euler.&amp;nbsp;" vertex="1">
          <mxGeometry height="120" width="900" x="110" y="1215" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#B03A2E;dashed=1;dashPattern=6 4;fontColor=#7B241C;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;ultrasonic_fusion_node&lt;/b&gt;  [t=3.5s]  &amp;#8212;  &lt;b&gt;DISABLED&lt;/b&gt;&lt;br&gt;&lt;b&gt;Trạng thái:&lt;/b&gt; BỊ COMMENT trong LaunchDescription (dòng &lt;b&gt;463&lt;/b&gt;) &amp;#8594; KHÔNG chạy.&lt;br&gt;&lt;b&gt;Vai trò (nếu bật):&lt;/b&gt; gộp /ultrasonic/* &amp;#8594; /ultrasonic_scan (LaserScan) để bơm vào costmap, bù vùng mù LiDAR.&lt;br&gt;&lt;b&gt;Bug đã xác nhận:&lt;/b&gt; SENSOR_POSES trùng toạ độ (mọi sensor trái = 0.29, 0.18; phải = 0.29, &amp;#8722;0.18) &amp;#8594; không bù đúng vùng mù.&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; mobile_robot · &lt;b&gt;exec:&lt;/b&gt; ultrasonic_fusion_node.py.  &amp;#160;&lt;i&gt;src: định nghĩa :290&amp;#8211;304 · vô hiệu :463; ultrasonic_fusion_node.py:11&amp;#8211;18&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="900" x="110" y="1355" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;ekf_filter_node&lt;/b&gt;  [t=7.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; EKF (robot_localization) hợp nhất /odom + /imu/data → phát &lt;b&gt;TF odom→base_footprint&lt;/b&gt; và /odometry/filtered. Đây là mắt xích định vị cục bộ (dead-reckoning) trước AMCL.&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; robot_localization · &lt;b&gt;exec:&lt;/b&gt; ekf_node · &lt;b&gt;Config:&lt;/b&gt; config/ekf.yaml.&amp;nbsp;" vertex="1">
          <mxGeometry height="140" width="900" x="110" y="1525" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;scan_to_scan_filter_chain&lt;/b&gt;  [t=10.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; lọc /scan (cắt góc/biên theo cấu hình) → /scan_filtered, dùng cho AMCL &amp;amp; costmap.&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; laser_filters · &lt;b&gt;exec:&lt;/b&gt; scan_to_scan_filter_chain · &lt;b&gt;Config:&lt;/b&gt; config/laser_filter.yaml.&amp;nbsp;" vertex="1">
          <mxGeometry height="130" width="900" x="110" y="1685" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;nav2_bringup&lt;/b&gt;  [t=12.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; khởi động toàn bộ stack Nav2 (định vị + lập kế hoạch + điều khiển + cây hành vi).&lt;br&gt;&lt;b&gt;Loại:&lt;/b&gt; IncludeLaunchDescription → &lt;b&gt;nav2_bringup/launch/bringup_launch.py&lt;/b&gt; (gói ngoài).&lt;br&gt;&lt;b&gt;launch_args:&lt;/b&gt; map=maps/map_&amp;lt;floor&amp;gt;.yaml · params_file=config/&lt;b&gt;nav2_params_test.yaml&lt;/b&gt; · use_sim_time.&amp;nbsp;" vertex="1">
          <mxGeometry height="150" width="900" x="110" y="1835" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;↳ &lt;font style=&quot;font-size: 12px;&quot;&gt;bringup_launch.py&lt;/font&gt; bung ra (gói ngoài — cấu trúc chuẩn nav2_bringup Foxy):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;b&gt;map_server&lt;/b&gt; (nạp maps/map_&amp;lt;floor&amp;gt;.yaml) &amp;nbsp; &lt;br&gt;&lt;div&gt;&amp;nbsp; • &lt;b&gt;amcl&lt;/b&gt; (định vị Monte-Carlo, phát TF map→odom)&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;b&gt;planner_server&lt;/b&gt; (global planner)&lt;/div&gt;&lt;div&gt;&amp;nbsp; • &lt;b&gt;controller_server&lt;/b&gt; (&lt;b&gt;DWB local planner&lt;/b&gt;)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; • &lt;b&gt;bt_navigator&lt;/b&gt; (Behavior Tree)&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;b&gt;waypoint_follower&lt;/b&gt; · &lt;b&gt;recoveries/behavior_server&lt;/b&gt; · &lt;b&gt;lifecycle_manager&lt;/b&gt; (localization + navigation)&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;b&gt;local_costmap&lt;/b&gt; + &lt;b&gt;global_costmap&lt;/b&gt;&lt;br&gt;&lt;b&gt;Toàn bộ tham số các node trên đọc từ:&lt;/b&gt; config/nav2_params_test.yaml.  &amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Lưu ý: đây là gói ngoài, không phải file trong project — danh sách node theo cấu trúc bringup chuẩn của Nav2 Foxy.&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="860" x="130" y="2005" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;global_localizer&lt;/b&gt;  [t=14.0s]&lt;br&gt;&lt;/font&gt;&lt;b&gt;Vai trò:&lt;/b&gt; tự định vị toàn cục lúc khởi động (thay set_initial_pose cứng). Trình tự: chờ AMCL active → gọi /reinitialize_global_localization (rải hạt) → xoay tại chỗ gom quan sát LiDAR → kiểm tra hội tụ covariance → xác nhận pose → Pub /global_localizer/ready.&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; mobile_robot · &lt;b&gt;exec:&lt;/b&gt; global_localizer.py&lt;br&gt;&lt;b&gt;Tham số (đặt INLINE trong launch, KHÔNG từ yaml):&lt;/b&gt; conv_xy=&lt;b&gt;0.10&lt;/b&gt;, conv_yaw=&lt;b&gt;0.15&lt;/b&gt;, spin=&lt;b&gt;0.4&lt;/b&gt;rad/s, max_spin=&lt;b&gt;3&lt;/b&gt;, amcl_timeout=&lt;b&gt;30&lt;/b&gt;s&lt;br&gt;&lt;b&gt;Sub:&lt;/b&gt; /amcl_pose · &lt;b&gt;Pub:&lt;/b&gt; /cmd_vel, /initialpose, /global_localizer/ready · &lt;b&gt;Srv:&lt;/b&gt; /reinitialize_global_localization&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="900" x="110" y="2195" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;navigator (checkpoint navigator)&lt;/b&gt;  [t=20.0s]&lt;br&gt;&lt;b&gt;Vai trò:&lt;/b&gt; state machine điều phối waypoint — nhận lệnh, tính đường, gửi goal &lt;b&gt;NavigateToPose&lt;/b&gt; tới Nav2, chờ tại checkpoint, tự về Home.&lt;br&gt;&lt;b&gt;State:&lt;/b&gt; IDLE → COMPUTING_PATH → PRE_ROTATING → NAVIGATING → (AT_CHECKPOINT 15s) → RETURNING_HOME. Lệnh: go/stop/continue/reset.&lt;br&gt;&lt;b&gt;Gói:&lt;/b&gt; mobile_robot · &lt;b&gt;exec:&lt;/b&gt; navigator.py&lt;br&gt;&lt;b&gt;Config:&lt;/b&gt; config/checkpoints_&amp;lt;floor&amp;gt;.yaml (=checkpoints_e6_v1.yaml) · timeout_at_checkpoint=30 · home_checkpoint_id=&lt;b&gt;0&lt;/b&gt;&lt;br&gt;&lt;b&gt;Sub:&lt;/b&gt; /robot/command · &lt;b&gt;Pub:&lt;/b&gt; /robot/state, /robot/current_checkpoint, /robot/status_message, /cmd_vel (chỉ khi PRE_ROTATING)&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="900" x="110" y="2405" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C65911;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;A. FILE CẤU HÌNH / MÔ HÌNH ĐƯỢC TIÊU THỤ&lt;/b&gt;  (file → node dùng)&lt;br&gt;&lt;/font&gt;&lt;br&gt;• urdf/mobile_robot.urdf.xacro → &lt;b&gt;robot_state_publisher&lt;/b&gt;&lt;br&gt;• config/wheel_odom_params.yaml → &lt;b&gt;wheel_odom_node&lt;/b&gt;&lt;br&gt;• config/bno055_params.yaml → &lt;b&gt;bno055&lt;/b&gt;&lt;br&gt;• config/ekf.yaml → &lt;b&gt;ekf_filter_node&lt;/b&gt;&lt;br&gt;• config/laser_filter.yaml → &lt;b&gt;scan_to_scan_filter_chain&lt;/b&gt;&lt;br&gt;• config/&lt;b&gt;nav2_params_test.yaml&lt;/b&gt; → &lt;b&gt;Nav2 stack&lt;/b&gt; (AMCL, DWB, planner, BT, costmaps)&lt;br&gt;• maps/map_&amp;lt;floor&amp;gt;.yaml → &lt;b&gt;map_server&lt;/b&gt; (Nav2)&lt;br&gt;• config/checkpoints_&amp;lt;floor&amp;gt;.yaml → &lt;b&gt;navigator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Nguồn: nav_v3_launch.py:58–63, 123–129, 314, 355, 376, 427.&lt;br&gt;Lưu ý: các đường dẫn trỏ tới thư mục install (pkg_share) của gói mobile_robot; bản copy project để phẳng nên không thấy thư mục maps/config, nhưng checkpoints_e6_v1.yaml có mặt trong project.&lt;/i&gt;" vertex="1">
          <mxGeometry height="360" width="594" x="1040" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;B. CÂY TF (frame &amp;#8594; frame : node phát)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#160;&amp;#160;&lt;b&gt;map&lt;/b&gt;&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#8595;&amp;#160;&amp;#160;(amcl &amp;#8212; định vị toàn cục)&lt;br&gt;&amp;#160;&amp;#160;&lt;b&gt;odom&lt;/b&gt;&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#8595;&amp;#160;&amp;#160;(ekf_filter_node &amp;#8212; robot_localization)&lt;br&gt;&amp;#160;&amp;#160;&lt;b&gt;base_footprint &amp;#8594; base_link &amp;#8594; laser_frame / bánh xe&lt;/b&gt;&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#8593;&amp;#160;&amp;#160;(robot_state_publisher, từ URDF; TF tĩnh)&lt;br&gt;&lt;br&gt;&lt;i&gt;Nguồn: nav_v3_launch.py:9, 14, 219 (publish_tf=false &amp;#8594; EKF lo odom&amp;#8594;base). map&amp;#8594;odom theo hành vi chuẩn AMCL.&lt;/i&gt;" vertex="1">
          <mxGeometry height="240" width="594" x="1040" y="880" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;C. ĐỐI CHIẾU &amp;amp; CẢNH BÁO (kiểm chứng trực tiếp từ source)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Hai node bị vô hiệu.&lt;/b&gt; jetson_sensor_bridge (:462) và ultrasonic_fusion (:463) bị comment trong LaunchDescription &amp;#8594; chuỗi siêu âm KHÔNG hoạt động dù có mã. Hệ quả: costmap không có nguồn bù vùng mù LiDAR.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. File params Nav2.&lt;/b&gt; Launch dùng &lt;b&gt;nav2_params_test.yaml&lt;/b&gt; (:63), KHÔNG phải nav2_params.yaml. Mọi tinh chỉnh AMCL/DWB phải sửa đúng file _test.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. floor mặc định lệch nhau.&lt;/b&gt; run_nav.sh đặt FLOOR=&lt;b&gt;e6_v1&lt;/b&gt; (:55) nhưng nav_v3_launch.py khai báo default=&lt;b&gt;a1&lt;/b&gt; (:74). Khi chạy qua run_nav.sh, giá trị truyền vào &amp;#8594; e6_v1 thắng (map/checkpoint theo e6_v1).&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Tên file launch.&lt;/b&gt; run_nav.sh gọi &amp;#8216;nav_v3.launch.py&amp;#8217; (:47); file nguồn trong project tên &amp;#8216;nav_v3_launch.py&amp;#8217;. Đây là tên đã cài trong gói (install), không mâu thuẫn nếu setup.py map đúng &amp;#8212; chưa kiểm chứng được vì không có setup.py trong danh sách.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Tham số global_localizer.&lt;/b&gt; Docstring nói &amp;#8216;tunable from nav2_params_test.yaml&amp;#8217; nhưng launch thực tế truyền INLINE (:399&amp;#8211;406) &amp;#8594; sửa yaml sẽ KHÔNG có tác dụng với node này." vertex="1">
          <mxGeometry height="560" width="594" x="1040" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;D. CHÚ GIẢI&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Màu khối:&lt;/b&gt;&lt;br&gt;&amp;#160;&amp;#160;• &lt;b&gt;Xanh dương&lt;/b&gt; = driver / nguồn sensor &amp;amp; TF tĩnh&lt;br&gt;&amp;#160;&amp;#160;• &lt;b&gt;Vàng&lt;/b&gt; = xử lý lõi (EKF, filter, Nav2, localizer)&lt;br&gt;&amp;#160;&amp;#160;• &lt;b&gt;Trắng-cam&lt;/b&gt; = node phụ trợ / danh sách con&lt;br&gt;&amp;#160;&amp;#160;• &lt;b&gt;Xanh lá&lt;/b&gt; = orchestrator / sinh lệnh / ghi bag&lt;br&gt;&amp;#160;&amp;#160;• &lt;b&gt;Hồng&lt;/b&gt; = file cấu hình / tham chiếu&lt;br&gt;&amp;#160;&amp;#160;• &lt;b&gt;Xám&lt;/b&gt; = ghi chú / đối chiếu&lt;br&gt;&amp;#160;&amp;#160;• &lt;b&gt;Viền đứt đỏ + nền xám&lt;/b&gt; = &lt;b&gt;DISABLED&lt;/b&gt; (có mã nhưng bị comment, KHÔNG chạy)&lt;br&gt;&lt;br&gt;&lt;b&gt;[t=Xs]&lt;/b&gt; = thời điểm khởi động qua TimerAction (giây sau khi launch bắt đầu).&lt;br&gt;&lt;b&gt;src: file:dòng&lt;/b&gt; = trích dẫn để bạn tự kiểm chứng." vertex="1">
          <mxGeometry height="300" width="594" x="1040" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;E. run_nav.sh &amp;#8212; DỌN DẸP KHI THOÁT (trap EXIT, :445)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chạy cleanup() cho mọi lối thoát (Ctrl+C/lỗi/kết thúc):&lt;br&gt;&amp;#160;&amp;#160;(1) publish /cmd_vel = 0 (dừng bánh xe)&lt;br&gt;&amp;#160;&amp;#160;(2) tắt node sinh lệnh (navigator, teleop, endurance)&lt;br&gt;&amp;#160;&amp;#160;(3) soft-kill các node non-wheel (Nav2, amcl, ekf, lidar, filter, imu...)&lt;br&gt;&amp;#160;&amp;#160;(4) publish /cmd_vel = 0 lần cuối &amp;#8594; tắt &lt;b&gt;wheel_odom_node sau cùng&lt;/b&gt;&lt;br&gt;&amp;#160;&amp;#160;(5) nếu HARD_KILL &amp;#8594; pkill -9 tiến trình còn sót + &amp;#8216;ros2 bag record&amp;#8217;&lt;br&gt;&lt;br&gt;&lt;b&gt;2 chế độ:&lt;/b&gt; fast (6 bước) / deep (9 bước: thêm lifecycle shutdown Nav2 + dọn FastDDS + stop ros2 daemon).  &lt;i&gt;src: run_nav.sh:262&amp;#8211;344&lt;/i&gt;" vertex="1">
          <mxGeometry height="290" width="594" x="1040" y="2040" as="geometry" />
        </mxCell>
        <mxCell id="ZJGrHEG7wJ-8zvPL_amB-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;F. run_nav.sh &amp;#8212; CHUẨN BỊ TRƯỚC LAUNCH&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;[1]&lt;/b&gt; require ros2 &amp;amp; colcon; kiểm tra thư mục WS&lt;br&gt;&lt;b&gt;[2]&lt;/b&gt; cd $WS  (~/mbrobot_ws)&lt;br&gt;&lt;b&gt;[3]&lt;/b&gt; source /opt/ros/foxy/setup.bash&lt;br&gt;&lt;b&gt;[4]&lt;/b&gt; colcon build --packages-select mobile_robot  (mặc định SKIP_BUILD=true &amp;#8594; &lt;b&gt;bỏ qua&lt;/b&gt;)&lt;br&gt;&lt;b&gt;[5]&lt;/b&gt; source install/setup.bash&lt;br&gt;&lt;b&gt;[5b]&lt;/b&gt; ghi metadata: s{scenario}_run{run}_meta.txt (result=PENDING)&lt;br&gt;&lt;b&gt;[6]&lt;/b&gt; chạy lệnh ros2 launch (xem khối ①).&lt;br&gt;&lt;i&gt;src: run_nav.sh:481&amp;#8211;589&lt;/i&gt;" vertex="1">
          <mxGeometry height="260" width="594" x="1040" y="2350" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
