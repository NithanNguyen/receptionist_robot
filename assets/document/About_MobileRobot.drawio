        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3c6cb1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;INPUT &amp;nbsp;— LiDAR scan&lt;/b&gt;&lt;br&gt;Topic &amp;nbsp;: &lt;b&gt;/scan_filtered&lt;/b&gt;&lt;br&gt;Type &amp;nbsp;&amp;nbsp;: sensor_msgs/LaserScan&lt;br&gt;Rate &amp;nbsp;&amp;nbsp;: ~10 Hz &amp;nbsp;|&amp;nbsp; Frame: &lt;i&gt;laser_frame&lt;/i&gt;&lt;br&gt;Source : scan_to_scan_filter_chain&lt;br&gt;Param &amp;nbsp;: scan_topic = /scan_filtered" vertex="1">
          <mxGeometry height="120" width="420" x="80" y="120" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3c6cb1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;INPUT &amp;nbsp;— Odometry TF&lt;/b&gt;&lt;br&gt;TF &amp;nbsp;&amp;nbsp;&amp;nbsp;: &lt;b&gt;odom → base_footprint&lt;/b&gt;&lt;br&gt;Rate&amp;nbsp;: ~50 Hz&lt;br&gt;Source: ekf_filter_node (robot_localization)&lt;br&gt;Fuses : /odom (wheel) + /imu/data (BNO055)&lt;br&gt;Params: odom_frame=odom, base_frame=base_footprint" vertex="1">
          <mxGeometry height="120" width="440" x="580" y="120" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3c6cb1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;INPUT &amp;nbsp;— Sensor TF (static)&lt;/b&gt;&lt;br&gt;TF &amp;nbsp;&amp;nbsp;&amp;nbsp;: &lt;b&gt;base_footprint → laser_frame&lt;/b&gt;&lt;br&gt;Source: robot_state_publisher (URDF/xacro)&lt;br&gt;Type &amp;nbsp;: /tf_static (latched)&lt;br&gt;Lookup: tf_buffer_duration = 50.0 s&lt;br&gt;Timeout: transform_timeout = 1.0 s" vertex="1">
          <mxGeometry height="120" width="420" x="1100" y="120" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58900;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;SCAN TRIGGER GATE &amp;nbsp;— selective ingestion&lt;/b&gt;&lt;br&gt;&lt;i&gt;Add a new scan into the pose-graph ONLY when robot motion exceeds at least one threshold&lt;/i&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;• &lt;b&gt;minimum_travel_distance&lt;/b&gt; &amp;nbsp;= 0.2 m &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(translation threshold)&lt;br&gt;&amp;nbsp;• &lt;b&gt;minimum_travel_heading&lt;/b&gt; &amp;nbsp;= 0.5 rad ≈ 30°&amp;nbsp;&amp;nbsp;(rotation threshold — critical for diff-drive in-place turns)&lt;br&gt;&amp;nbsp;• &lt;b&gt;minimum_time_interval&lt;/b&gt; &amp;nbsp;&amp;nbsp;= 0.5 s &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(time threshold while stationary)&lt;br&gt;&amp;nbsp;• &lt;b&gt;throttle_scans&lt;/b&gt; &amp;nbsp;= 1 &amp;nbsp;&amp;nbsp;(=&gt; process every scan, no drop — AGX Xavier has headroom)" vertex="1">
          <mxGeometry height="160" width="800" x="400" y="290" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3f8c3f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;SCAN MATCHING &amp;nbsp;(correlative)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Align current scan to local sub-map → correct odom drift,&lt;br&gt;emit relative-pose constraint&lt;/i&gt;&lt;br&gt;─────────────&lt;br&gt;&lt;b&gt;Enable&lt;/b&gt;&lt;br&gt;&amp;nbsp;• use_scan_matching = true&lt;br&gt;&amp;nbsp;• use_scan_barycenter = true&lt;br&gt;&lt;br&gt;&lt;b&gt;Correlation search window&lt;/b&gt;&lt;br&gt;&amp;nbsp;• correlation_search_space_dimension = 0.8 m&lt;br&gt;&amp;nbsp;• correlation_search_space_resolution = 0.005 m&lt;br&gt;&amp;nbsp;• correlation_search_space_smear_deviation = 0.05&lt;br&gt;&lt;br&gt;&lt;b&gt;Angular search&lt;/b&gt;&lt;br&gt;&amp;nbsp;• fine_search_angle_offset = 0.00349 rad (≈0.2°)&lt;br&gt;&amp;nbsp;• coarse_search_angle_offset = 0.523 rad (≈30°)&lt;br&gt;&amp;nbsp;• coarse_angle_resolution = 0.0349 rad (≈2°)&lt;br&gt;&lt;br&gt;&lt;b&gt;Penalties &amp;amp; constraints&lt;/b&gt;&lt;br&gt;&amp;nbsp;• distance_variance_penalty = 0.5&lt;br&gt;&amp;nbsp;• angle_variance_penalty = 1.0 &amp;nbsp;(trust IMU yaw)&lt;br&gt;&amp;nbsp;• minimum_angle/distance_penalty = 0.9 / 0.5&lt;br&gt;&amp;nbsp;• use_response_expansion = true&lt;br&gt;&amp;nbsp;• link_scan_maximum_distance = 2.0 m&lt;br&gt;&amp;nbsp;• link_match_minimum_response_fine = 0.05" vertex="1">
          <mxGeometry height="380" width="460" x="20" y="500" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3f8c3f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;POSE GRAPH &amp;nbsp;(storage)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Graph G = (V, E)&lt;br&gt;&amp;nbsp;V = keyframe nodes (pose, scan)&lt;br&gt;&amp;nbsp;E = relative-pose constraints + covariance&lt;/i&gt;&lt;br&gt;─────────────&lt;br&gt;&lt;b&gt;Local rolling buffer&lt;/b&gt;&lt;br&gt;&amp;nbsp;• scan_buffer_size = 100&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(history depth used by scan matcher to absorb&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;sudden wheel slip)&lt;br&gt;&amp;nbsp;• scan_buffer_maximum_scan_distance = 12.0 m&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(drop laser points beyond 12 m from buffer)&lt;br&gt;&lt;br&gt;&lt;b&gt;Constraint sources&lt;/b&gt;&lt;br&gt;&amp;nbsp;• sequential scan-match edges (from Scan Matching)&lt;br&gt;&amp;nbsp;• loop-closure edges (from Loop Closure)&lt;br&gt;&lt;br&gt;&lt;b&gt;Persistence&lt;/b&gt;&lt;br&gt;&amp;nbsp;• serialisable as &lt;i&gt;.posegraph&lt;/i&gt; (resumable mapping)" vertex="1">
          <mxGeometry height="290" width="420" x="540" y="500" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3f8c3f;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;LOOP CLOSURE DETECTION&lt;/b&gt;&lt;br&gt;&lt;i&gt;Detect revisits of mapped regions to cancel&lt;br&gt;accumulated drift via global constraints&lt;/i&gt;&lt;br&gt;─────────────&lt;br&gt;&lt;b&gt;Activation&lt;/b&gt;&lt;br&gt;&amp;nbsp;• do_loop_closing = true&lt;br&gt;&lt;br&gt;&lt;b&gt;Candidate search&lt;/b&gt;&lt;br&gt;&amp;nbsp;• loop_search_maximum_distance = 4.0 m&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(radius in pose-graph to look for revisits)&lt;br&gt;&amp;nbsp;• loop_match_minimum_chain_size = 8&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(reject false matches in repetitive corridors)&lt;br&gt;&lt;br&gt;&lt;b&gt;Coarse search (wide / cheap)&lt;/b&gt;&lt;br&gt;&amp;nbsp;• loop_search_space_dimension = 8.0 m&lt;br&gt;&amp;nbsp;• loop_search_space_resolution = 0.05 m&lt;br&gt;&amp;nbsp;• loop_search_space_smear_deviation = 0.03&lt;br&gt;&amp;nbsp;• loop_match_maximum_variance_coarse = 3.0&lt;br&gt;&amp;nbsp;• loop_match_minimum_response_coarse = 0.25&lt;br&gt;&lt;br&gt;&lt;b&gt;Fine validation (tight / accept)&lt;/b&gt;&lt;br&gt;&amp;nbsp;• loop_match_minimum_response_fine = 0.35" vertex="1">
          <mxGeometry height="350" width="460" x="1020" y="500" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;POSE-GRAPH OPTIMIZATION &amp;nbsp;(Ceres Solver)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Non-linear least-squares over all constraints in G → globally consistent pose set&lt;/i&gt;&lt;br&gt;─────────────&lt;br&gt;&amp;nbsp;• &lt;b&gt;solver_plugin&lt;/b&gt; = solver_plugins::CeresSolver&lt;br&gt;&amp;nbsp;• &lt;b&gt;ceres_linear_solver&lt;/b&gt; = SPARSE_NORMAL_CHOLESKY &amp;nbsp;(sparse, optimal for 2-D SLAM)&lt;br&gt;&amp;nbsp;• &lt;b&gt;ceres_preconditioner&lt;/b&gt; = SCHUR_JACOBI &amp;nbsp;(faster convergence on Jetson)&lt;br&gt;&amp;nbsp;• &lt;b&gt;ceres_trust_strategy&lt;/b&gt; = LEVENBERG_MARQUARDT &amp;nbsp;(robust Gauss-Newton ⇄ gradient descent)&lt;br&gt;&amp;nbsp;• &lt;b&gt;ceres_dogleg_type&lt;/b&gt; = TRADITIONAL_DOGLEG &amp;nbsp;(trust-region sub-problem)&lt;br&gt;&amp;nbsp;• &lt;b&gt;ceres_loss_function&lt;/b&gt; = None &amp;nbsp;(indoor — few outliers, no robustifier needed)&lt;br&gt;&amp;nbsp;• &lt;b&gt;stack_size_to_use&lt;/b&gt; = 40 000 000 B (40 MB / solver thread)&lt;br&gt;&lt;br&gt;Output → corrected pose set drives both: &lt;b&gt;(a)&lt;/b&gt; map re-rasterisation, &lt;b&gt;(b)&lt;/b&gt; TF map→odom" vertex="1">
          <mxGeometry height="200" width="800" x="400" y="940" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b59a3;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;OCCUPANCY GRID BUILDER &amp;nbsp;→ /map&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ray-cast corrected scans into a 2-D log-odds probability grid&lt;/i&gt;&lt;br&gt;─────────────&lt;br&gt;&lt;b&gt;Geometry&lt;/b&gt;&lt;br&gt;&amp;nbsp;• resolution = 0.05 m / cell &amp;nbsp;(5 cm)&lt;br&gt;&amp;nbsp;• max_laser_range = 10.0 m &amp;nbsp;(RPLIDAR S2E indoor)&lt;br&gt;&lt;br&gt;&lt;b&gt;Rebuild cadence&lt;/b&gt;&lt;br&gt;&amp;nbsp;• map_update_interval = 6.0 s&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT topic&lt;/b&gt;&lt;br&gt;&amp;nbsp;• &lt;b&gt;/map&lt;/b&gt; &amp;nbsp;|&amp;nbsp; nav_msgs/OccupancyGrid &amp;nbsp;|&amp;nbsp; frame = &lt;i&gt;map&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="620" x="80" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="NCSUaIeV7ux0R8ZJJDhV-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b59a3;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="&lt;b&gt;TF PUBLISHER &amp;nbsp;— map → odom&lt;/b&gt;&lt;br&gt;&lt;i&gt;Continuously broadcast the correction between&lt;br&gt;map frame and the EKF odometric frame&lt;/i&gt;&lt;br&gt;─────────────&lt;br&gt;&amp;nbsp;• transform_publish_period = 0.02 s &amp;nbsp;⇒ &lt;b&gt;50 Hz&lt;/b&gt;&lt;br&gt;&amp;nbsp;• Published TF: &lt;b&gt;map → odom&lt;/b&gt; &amp;nbsp;(Δpose = corrected − odometric)&lt;br&gt;&amp;nbsp;• Consumed by: Nav2 (Controller/Planner), RViz&lt;br&gt;&lt;br&gt;&lt;b&gt;TF ownership (do not duplicate!)&lt;/b&gt;&lt;br&gt;&amp;nbsp;• map → odom &amp;nbsp;&amp;nbsp;: this node (SLAM)&lt;br&gt;&amp;nbsp;• odom → base_footprint : EKF&lt;br&gt;&amp;nbsp;• base_footprint → laser_frame : URDF (RSP)" vertex="1">
          <mxGeometry height="190" width="620" x="900" y="1190" as="geometry" />
        </mxCell>
