  </diagram>
  <diagram id="vXj7q-h2g3hxUoTXrFis" name="Kinematic">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gWnSghvKp_syU2xFTn_5-31" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#0E2841;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" value="wheel_odom_node.py  —  WheelOdomNode  —  ROS 2 Differential Drive Odometry" vertex="1">
          <mxGeometry height="45" width="1614" x="30" y="90" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-32" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F5496;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="HARDWARE" vertex="1">
          <mxGeometry height="30" width="220" x="30" y="145" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F5496;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="ROS TOPICS" vertex="1">
          <mxGeometry height="30" width="280" x="1330" y="145" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;STM32&lt;/b&gt; — Hoverboard FOC Controller&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Điều khiển 2 motor BLDC, trả encoder velocity qua UART full-duplex.&lt;br&gt;&lt;b&gt;UART:&lt;/b&gt; /dev/ttyWheel @ 115200 baud,  8 N 1,  timeout=0.1s&lt;br&gt;─────────────────────────────&lt;br&gt;&lt;b&gt;RX Packet (STM32→ROS)  8 bytes &amp;lt;HHHH&amp;gt;:&lt;/b&gt;&lt;br&gt;&amp;nbsp;[0-1] START=0xABCD  [2-3] ωR(u16)  [4-5] ωL(u16)  [6-7] checksum&lt;br&gt;&lt;b&gt;TX Packet (ROS→STM32)  8 bytes &amp;lt;HhhH&amp;gt;:&lt;/b&gt;&lt;br&gt;&amp;nbsp;[0-1] START=0xABCD  [2-3] steer(i16)  [4-5] speed(i16)  [6-7] checksum&lt;br&gt;─────────────────────────────&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt;  OMEGA_SCALE = &lt;b&gt;100.0&lt;/b&gt;  |  MOTOR_MAX_RPM = &lt;b&gt;40.0&lt;/b&gt;&lt;br&gt;ω_max = &lt;b&gt;4.189&lt;/b&gt; rad/s  |  v_max(HW) = &lt;b&gt;0.346&lt;/b&gt; m/s" vertex="1">
          <mxGeometry height="1497" width="220" x="30" y="183" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=top;fontSize=11;fontStyle=1;spacingTop=8;" value="WheelOdomNode  (ROS 2 Node)" vertex="1">
          <mxGeometry height="1535" width="780" x="410" y="145" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#42A5F5;fontColor=#1565C0;align=center;verticalAlign=top;fontSize=10;fontStyle=1;spacingTop=5;opacity=70;" value="► RX Pipeline  —  UART → /odom" vertex="1">
          <mxGeometry height="937" width="744" x="428" y="188" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;① Serial Reader Thread  —  _serial_reader_loop()&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Đọc encoder data UART liên tục, parse packet 8B, push vào Queue thread-safe.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; daemon=True — chạy suốt vòng đời process, hoàn toàn độc lập ROS spin.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) waiting = ser.in_waiting or 1;  data = ser.read(waiting);  buffer.extend(data)&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) Scan: if buf[0]==0xCD and buf[1]==0xAB → extract packet[0:8];  else buf.pop(0)&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) _, wR, wL, _ = struct.unpack(&#39;&amp;lt;HHHH&amp;gt;&#39;, packet)&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) ωL = (wL − 32768) / 100.0   ωR = (wR − 32768) / 100.0   [rad/s]&lt;br&gt;&amp;nbsp;&amp;nbsp;(5) if Queue.full() → get_nowait()  (drop oldest, anti-lag)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Queue.put_nowait({ &#39;omega_L&#39;: ωL, &#39;omega_R&#39;: ωR })&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt;  START_FRAME = &lt;b&gt;0xABCD&lt;/b&gt;,  PACKET_FORMAT = &lt;b&gt;&#39;&amp;lt;HHHH&amp;gt;&#39;&lt;/b&gt;,  OMEGA_SCALE = &lt;b&gt;100.0&lt;/b&gt;" vertex="1">
          <mxGeometry height="275" width="720" x="440" y="210" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;② Packet Queue  —  queue.Queue(maxsize=50)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Buffer thread-safe tách biệt clock domain UART-async ↔ ROS Timer @100 Hz.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; put_nowait() từ ① Serial Thread;  get_nowait() từ ③ ROS Timer.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;  Item = { &#39;omega_L&#39;: float [rad/s],  &#39;omega_R&#39;: float [rad/s] }&lt;br&gt;&amp;nbsp;&amp;nbsp;Full (50 items)? → drop oldest (get) → put new;  consumer drains mỗi 0.01s&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt;  maxsize = &lt;b&gt;50&lt;/b&gt;  (≈ 0.5s buffer @ 100 Hz)" vertex="1">
          <mxGeometry height="138" width="720" x="440" y="500" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;③ ROS Timer @100 Hz  —  _process_queue()&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Drain toàn bộ Queue mỗi chu kỳ, đảm bảo không tích lũy lag.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; create_timer(0.01) — 100 Hz, callback không block.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;  while not queue.empty():  pkt = get_nowait()  →  _update_odom(ωL, ωR)&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt;  timer_period = &lt;b&gt;0.01 s&lt;/b&gt;  (100 Hz)" vertex="1">
          <mxGeometry height="105" width="720" x="440" y="653" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;④ _update_odom(ωL, ωR)  →  _publish_odom_and_tf(v, w, t)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Dead-reckoning Differential Drive → tính pose robot → publish /odom + TF.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Gọi trực tiếp từ ③ cho mỗi packet drain khỏi Queue.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) dt = (now − last_time).nanoseconds / 1e9 ;  if dt ≤ 0: return&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) vL = ωL × R = ωL × 0.08255     vR = ωR × R = ωR × 0.08255    [m/s]&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) v  = (vR + vL) / 2.0                                            [m/s]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;w  = (vR − vL) / L = (vR − vL) / 0.42109   [rad/s]&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) Δx = v·cos(θ)·dt      Δy = v·sin(θ)·dt      Δθ = w·dt&lt;br&gt;&amp;nbsp;&amp;nbsp;(5) x += Δx    y += Δy    θ += Δθ    last_time = now  →  update State Vars&lt;br&gt;&amp;nbsp;&amp;nbsp;(6) Build Odometry msg: frame_id=&#39;odom&#39;, child=&#39;base_footprint&#39;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;orientation = quaternion from θ:  z=sin(θ/2),  w=cos(θ/2)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;odom_pub.publish(odom)  |  [opt] tf_broadcaster.sendTransform(t)&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt;  R = &lt;b&gt;0.08255&lt;/b&gt; m,  L = &lt;b&gt;0.42109&lt;/b&gt; m  (URDF / wheel_odom_params.yaml)" vertex="1">
          <mxGeometry height="340" width="720" x="440" y="773" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4C3;strokeColor=#AFB42B;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;State Variables  —  Persistent, khởi tạo = 0 khi node start&lt;/b&gt;&lt;br&gt;self.x = &lt;b&gt;0.0&lt;/b&gt; [m]  ·  self.y = &lt;b&gt;0.0&lt;/b&gt; [m]  ·  self.theta = &lt;b&gt;0.0&lt;/b&gt; [rad]  ·  self.last_time : rclpy.Time  (đọc/ghi bởi ④)" vertex="1">
          <mxGeometry height="80" width="744" x="428" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFA726;fontColor=#E65100;align=center;verticalAlign=top;fontSize=10;fontStyle=1;spacingTop=5;opacity=70;" value="◀ TX Pipeline  —  /cmd_vel → UART" vertex="1">
          <mxGeometry height="400" width="744" x="428" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;⑤ _cmd_vel_callback(msg: Twist)  —  Subscription QoS=10&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Chuyển ROS velocity → STM32 integer unit, áp dụng safety clamp 2 lớp.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Mỗi message publish lên topic /cmd_vel (từ Nav2 Controller Server).&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) [SW Clamp]  v = clip(msg.linear.x,   ±0.6)    w = clip(msg.angular.z, ±1.5)&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) [Scale]     speed = int(v × 116)               steer = int(−w × 24)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(dấu âm: quy ước chiều quay STM32 firmware)&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) [HW Clamp]  speed = clip(speed, ±70)           steer = clip(steer, ±60)&lt;br&gt;&amp;nbsp;&amp;nbsp;(4) → _send_command(speed, steer)&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt;  MAX_V=&lt;b&gt;0.6&lt;/b&gt; m/s, MAX_W=&lt;b&gt;1.5&lt;/b&gt; rad/s,  K_spd=&lt;b&gt;116&lt;/b&gt;, K_str=&lt;b&gt;24&lt;/b&gt;,  SPD_MAX=&lt;b&gt;70&lt;/b&gt;, STR_MAX=&lt;b&gt;60&lt;/b&gt;" vertex="1">
          <mxGeometry height="198" width="720" x="440" y="1243" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=5;" value="&lt;b&gt;⑥ _send_command(speed: int, steer: int)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mục đích:&lt;/b&gt; Đóng gói motor command 8 byte, gửi về STM32 qua UART thread-safe.&lt;br&gt;&lt;b&gt;Kích hoạt:&lt;/b&gt; Gọi bởi ⑤ sau mỗi velocity message nhận được.&lt;br&gt;&lt;b&gt;Quy trình:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(1) checksum = (0xABCD ⊕ (steer &amp;amp; 0xFFFF) ⊕ (speed &amp;amp; 0xFFFF)) &amp;amp; 0xFFFF&lt;br&gt;&amp;nbsp;&amp;nbsp;(2) pkt = struct.pack(&#39;&amp;lt;HhhH&amp;gt;&#39;,  0xABCD,  steer,  speed,  checksum)&lt;br&gt;&amp;nbsp;&amp;nbsp;(3) with self._serial_lock:  ser.write(pkt)   [8 bytes, Little-Endian]&lt;br&gt;&lt;b&gt;Tham số:&lt;/b&gt;  CMD_START_FRAME = &lt;b&gt;0xABCD&lt;/b&gt;,  Lock = threading.Lock()" vertex="1">
          <mxGeometry height="158" width="720" x="440" y="1456" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;/odom&lt;/b&gt;&lt;br&gt;&lt;i&gt;nav_msgs/Odometry&lt;/i&gt;  — QoS depth: 10&lt;br&gt;─────────────────────&lt;br&gt;frame_id = &#39;odom&#39;&lt;br&gt;child_frame_id = &#39;base_footprint&#39;&lt;br&gt;position.x  = self.x  [m]&lt;br&gt;position.y  = self.y  [m]&lt;br&gt;orient.z    = sin(θ/2)&lt;br&gt;orient.w    = cos(θ/2)&lt;br&gt;twist.linear.x   = v  [m/s]&lt;br&gt;twist.angular.z  = w  [rad/s]" vertex="1">
          <mxGeometry height="178" width="280" x="1330" y="183" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" value="&lt;b&gt;TF: odom → base_footprint&lt;/b&gt;&lt;br&gt;&lt;i&gt;geometry_msgs/TransformStamped&lt;/i&gt;&lt;br&gt;─────────────────────&lt;br&gt;&lt;i&gt;Conditional:  publish_tf param&lt;/i&gt;&lt;br&gt;&lt;i&gt;Default = &lt;b&gt;False&lt;/b&gt;  (EKF handles TF)&lt;/i&gt;&lt;br&gt;tf_broadcaster.sendTransform(t)" vertex="1">
          <mxGeometry height="138" width="280" x="1330" y="378" as="geometry" />
        </mxCell>
        <mxCell id="gWnSghvKp_syU2xFTn_5-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C65911;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Kinematics Reference  —  Differential Drive Model&lt;/b&gt;&lt;br&gt;────────────────────────────────────&lt;br&gt;&lt;b&gt;1.  Encoder → ω (rad/s):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;ω = (raw_u16 − 32768) / ΩSCALE&lt;br&gt;&lt;b&gt;2.  ω → Wheel linear velocity:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;vL = ωL × R      vR = ωR × R        [m/s]&lt;br&gt;&lt;b&gt;3.  Robot body velocity (ICR model):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;v = (vR + vL) / 2                    [m/s]&lt;br&gt;&amp;nbsp;&amp;nbsp;ω = (vR − vL) / L                   [rad/s]&lt;br&gt;&lt;b&gt;4.  Euler integration (dead reckoning):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;x(k+1) = x(k) + v·cos(θ)·dt&lt;br&gt;&amp;nbsp;&amp;nbsp;y(k+1) = y(k) + v·sin(θ)·dt&lt;br&gt;&amp;nbsp;&amp;nbsp;θ(k+1) = θ(k) + ω·dt&lt;br&gt;────────────────────────────────────&lt;br&gt;&lt;b&gt;Parameters (wheel_odom_params.yaml):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;R (wheel radius)  = &lt;b&gt;0.08255&lt;/b&gt; m&lt;br&gt;&amp;nbsp;&amp;nbsp;L (wheel base)    = &lt;b&gt;0.42109&lt;/b&gt; m&lt;br&gt;&amp;nbsp;&amp;nbsp;OMEGA_SCALE       = &lt;b&gt;100.0&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;MOTOR_MAX_RPM     = &lt;b&gt;40.0&lt;/b&gt;   → ω_max = &lt;b&gt;4.189&lt;/b&gt; rad/s&lt;br&gt;&amp;nbsp;&amp;nbsp;v_max (hardware)  = &lt;b&gt;0.346&lt;/b&gt; m/s&lt;br&gt;────────────────────────────────────&lt;br&gt;&lt;b&gt;Orientation:&lt;/b&gt;  quaternion from yaw θ only&lt;br&gt;(planar robot, z=sin(θ/2), w=cos(θ/2))" vertex="1">
          <mxGeometry height="680" width="280" x="1330" y="533" as="geometry" />
        </mxCell>
