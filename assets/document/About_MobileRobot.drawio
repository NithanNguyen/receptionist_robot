        <mxCell id="33u3eQPU6rhDYbHWuPK0-61" edge="1" parent="1" source="33u3eQPU6rhDYbHWuPK0-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B85450;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=9;labelBackgroundColor=#FFFFFF;" target="33u3eQPU6rhDYbHWuPK0-46" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); background-color: light-dark(rgb(0, 0, 0), rgb(255, 181, 112));&quot;&gt;{(x̄ᵢ, wᵢ)}&lt;/font&gt;">
