        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-76" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82B366;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;labelBackgroundColor=#FFFFFF;" target="7JBYn4sk39azXEOEYMLu-69" value="&lt;span style=&#39;font-size:9px&#39;&gt;/cmd_vel  20 Hz&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1220" y="1400" />
              <mxPoint x="1220" y="225" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-77" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B85450;strokeWidth=1.5;endArrow=classic;endFill=1;" target="7JBYn4sk39azXEOEYMLu-58" value="">
          <mxGeometry relative="1" as="geometry" />
