        <mxCell id="7JBYn4sk39azXEOEYMLu-78" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B85450;strokeWidth=1.5;endArrow=classic;endFill=1;" target="7JBYn4sk39azXEOEYMLu-59" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-79" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B85450;strokeWidth=1.5;endArrow=classic;endFill=1;" target="7JBYn4sk39azXEOEYMLu-68" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-80" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673A6;strokeWidth=1.5;endArrow=classic;endFill=1;dashed=1;fontSize=9;labelBackgroundColor=#FFFFFF;" target="7JBYn4sk39azXEOEYMLu-58" value="&lt;span style=&#39;font-size:9px&#39;&gt;costmap data&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1140" y="295" />
              <mxPoint x="1140" y="825" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-81" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.206;entryDx=0;entryDy=0;entryPerimeter=0;" target="7JBYn4sk39azXEOEYMLu-54">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JBYn4sk39azXEOEYMLu-82" edge="1" parent="1" source="7JBYn4sk39azXEOEYMLu-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.002;entryY=0.655;entryDx=0;entryDy=0;entryPerimeter=0;" target="7JBYn4sk39azXEOEYMLu-54">
